;; Live DYADT claims. Verified by scripts/verify-claims.sh.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "claims"
  :beholding-chora #u5"estate/chora"
  (ledger :schema "dyadt/claim@1" :session "session_0114ps6mY5jAH4Sz" :actor "claude-opus-4-8" :emitted-commit "HEAD")
  (claim :id C1 :claim-class file-changed :verifier git-diff :expect "contains:Post-Action Claim Verification" :target "1-formats/sub-specs/did-you-actually-do-that/README.adoc" :statement "the DYADT front door defines the Tier-4 accountability pipeline")
  (claim :id C2 :claim-class file-changed :verifier git-diff :expect "contains:claim_class" :target "1-formats/sub-specs/did-you-actually-do-that/spec/CLAIM-FORMAT.adoc" :statement "the claim format spec defines typed claim classes")
  (claim :id C3 :claim-class file-changed :verifier git-diff :expect "contains:unverifiable" :target "1-formats/sub-specs/did-you-actually-do-that/spec/VERIFICATION-PROTOCOL.adoc" :statement "the verification protocol fixes the three-verdict contract")
  (claim :id C4 :claim-class file-changed :verifier git-diff :expect "contains:confirmation rate" :target "1-formats/sub-specs/did-you-actually-do-that/spec/CONSEQUENCE-LEDGER.adoc" :statement "the consequence ledger defines a per-actor confirmation rate")
  (claim :id C5 :claim-class file-changed :verifier git-diff :expect "contains:unverifiable" :target "scripts/verify-claims.sh" :statement "the reference verifier can emit an unverifiable verdict")
  (claim :id C6 :claim-class command-ran :verifier command-transcript :expect "exit==0" :target "bash 1-formats/sub-specs/did-you-actually-do-that/spec/conformance/run-conformance.sh" :statement "the DYADT conformance vector suite passes")
  (claim :id C7 :claim-class test-passed :verifier command-transcript :expect "exit==0" :target "bash scripts/tests/wave4-dyadt-test.sh" :statement "the verifier refutes a false claim and confirms a true one (self-check)")
)
