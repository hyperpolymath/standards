#
# debt.a2ml — Meander debt list
# Things found but not fixed. Carried between sessions.
# Becomes the next session's Phase 0 input.
#
# Reference: ADR-002 in standards/agentic-a2ml/docs/

[metadata]
version = "1.0.0"
last-updated = "2026-08-07"

# ============================================================================
# DEBT ITEMS
# ============================================================================
# Each item has: component, issue, effort (easy|medium|hard), impact (high|medium|low),
# priority (should|could), and discovered date.
#
# Items are consumed (removed) when fixed. New items are added at session end.
# The debt list prevents the "one more wave" loop — found things are persisted,
# not forgotten, and not used as justification for infinite meandering.

# ============================================================================
# SHOULD — would fix next wave
# ============================================================================
# These are inputs for the next session if the user says "keep going".
#
# Example:
# [[debt.should]]
# component = "system-tools/monitoring/observatory"
# issue = "Stale duplicate of root observatory/"
# effort = "easy"
# impact = "medium"
# discovered = "2026-03-23"

[[debt.should]]
component = "estate-wide / standards CLAUDE.md §Package Management"
issue = "Guix-primary ruling 2026-05-18 (Guix primary + sealed-container escape; NO Nix mirror). Tech debt to clear: (1) update standards CLAUDE.md §Package Management ('Fallback: Nix (flake.nix)' -> 'Escape hatch: sealed container; no Nix mirror'); (2) estate-wide sweep removing every flake.nix that only mirrors a guix.scm/manifest (echidna flake.nix deprecated in its L3/L1 PR as the pilot). A second packager is permitted ONLY where it is the sole source of a specific named dependency, documented as such."
effort = "hard"
impact = "medium"
priority = "should"
discovered = "2026-05-18"
ref = "memory: reference_packaging_guix_primary_container_escape"

# ============================================================================
# COULD — would fix eventually
# ============================================================================
# These are low-priority items that don't justify a session on their own.
# They get picked up when an agent is in the area for other reasons.
#
# Example:
# [[debt.could]]
# component = "cicada"
# issue = "RSR_OUTLINE.adoc references banned AGPL-3.0"
# effort = "easy"
# impact = "low"
# discovered = "2026-03-23"

# ============================================================================
# ESTATE CI/CD SWEEP 2026-08-07 — see Debtfile.adoc for the full measurements
# ============================================================================
# The two items below are blocked on a RULING, not on effort. Both were
# attempted and refused by the permission classifier, correctly, because each
# changes security gating across ~100 repositories.

[[debt.should]]
component = "estate-wide / OSSF Scorecard code-scanning alerts"
issue = "545 Scorecard alerts are FROZEN and cannot be closed by any code change: scorecard-reusable.yml runs `results_format: json` + `publish_results: true` and has NO upload-sarif step, so code scanning never receives a fresh run. Sample of 143 alerts: only 7 updated within 31 days; 8 date to 2025-12-18. Proven end-to-end — minting actions.lock in airborne-submarine-squadron and re-running Scorecard left PinnedDependenciesID at 5->5 and blocking alerts at 22->22, with updated_at frozen at 2026-05-17. The code_scanning ruleset rule names Scorecard as a blocking tool on 106 of 171 repos, so merges are gated on evidence up to eight months old. RECOMMENDED: drop Scorecard from the code_scanning rule (keep publishing the score) AND dismiss the 545 frozen alerts. Making the reusable upload SARIF instead would make alerts live, but Pinned-Dependencies does not model actions.lock and would keep firing on every lockfile repo."
effort = "easy"
impact = "high"
priority = "should"
discovered = "2026-08-07"

[[debt.should]]
component = "estate-wide / 15 repos pinned to governance+scorecard reusables @81dbf2dd"
issue = "These repos are judged by a ruleset predating the lockfile-aware branch of the SHA-pin check, so they report `ERROR: Found unpinned actions:` on repositories that HAVE a complete, verified actions.lock. A caller pinned to an old reusable CANNOT be reached by any fix made in the reusable — including everything shipped in standards#597 — so repointing to @main is unavoidable rather than tidy. @main is the estate convention for own-org reusables (hypatia SecurityErrors.@pin_exempt records the rationale). Trade-off to accept knowingly: a caller on @main runs whatever lands on standards/main immediately, with no per-repo pin; the only gate is the standards PR itself."
effort = "easy"
impact = "high"
priority = "should"
discovered = "2026-08-07"

[[debt.should]]
component = "estate-wide / 1,629 unacknowledged Hypatia + Scorecard findings"
issue = "Genuine engineering debt that SHOULD block: 276 banned_language_file, 142 zig_ptr_cast, 127 deprecated_api, 105 PinnedDependenciesID (repos with no lockfile), 104 CSA003, 96 TokenPermissionsID, 76 secret_detected, 70 secret_action_without_presence_gate. DO NOT SWEEP — every family examined so far contained false positives better fixed in the RULE than the code (WF017 flagged the only valid secret gate; shell_download_then_run flagged printed advice; ncl_http_url flagged XML namespace identifiers). Sample each family's failure TEXT first."
effort = "hard"
impact = "high"
priority = "should"
discovered = "2026-08-07"

[[debt.could]]
component = "standards / scripts/tests"
issue = "Four suites fail: governance-gates-505, wave0-false-green, wave3-scorecards, wave5-language-guides. They had never been run by any workflow before standards#588 wired scripts/tests/ into self-test.yml, so this is unexamined debt rather than new breakage. wave3 and wave5 have real assertion failures; the other two print PASS lines then exit non-zero later in the file. Deliberately NOT quarantined."
effort = "medium"
impact = "medium"
priority = "could"
discovered = "2026-08-07"

[[debt.could]]
component = "standards / governance-reusable.yml Deno CI"
issue = "The estate moved from Deno to Bun, but governance-reusable.yml still runs `deno run ... check-ts-allowlist.deno.js` and `deno / Deno CI` fails on standards pull requests. Not required anywhere, so it is noise rather than a blocker — but it is noise on every pull request."
effort = "medium"
impact = "low"
priority = "could"
discovered = "2026-08-07"

[[debt.could]]
component = "estate-wide / repos skipped by sweep guards"
issue = "Left untouched deliberately, each needing a human decision: hyperpolymath-sovereign-registry, phronesis, typefix-zero (duplicate SPDX identifiers in a workflow — the sweep refused to guess which is authoritative); awesome-idris2 (one workflow has NO identifier and the repo's others split MPL-2.0 / PMPL-1.0-or-later, so there is no unanimous licence to inherit); social-media-tools (push failed, no PR opened); lcb-website (no workflow files at all — a different fault wearing the lint-workflows name)."
effort = "easy"
impact = "low"
priority = "could"
discovered = "2026-08-07"

