# SPDX-License-Identifier: CC-BY-SA-4.0
# state-a2ml.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "state-a2ml"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "The spec MUST provide a formal grammar/schema (ABNF and/or JSON Schema) that accurately defines the syntax of the STATE file format currently in use."
system = "none"
status = "fail"
effects = "Consumers writing parsers or validators cannot trust spec/abnf/state.abnf or spec/schema/state.schema.json: both describe the deprecated S-expression Scheme format (top-level `(define state '((metadata ...))...)`), while the actual current artifact `.machine_readable/6a2/STATE.a2ml` is a TOML-like A2ML file with sections like `[metadata]`, `[project-context]`, `[position]`, `[route-to-mvp]` that appear nowhere in the ABNF/schema. Any tool built against the published grammar/schema will reject or mis-parse the real STATE.a2ml file."

[[must]]
id = "M2"
text = "Every source and specification file in the spec MUST carry an SPDX-License-Identifier header."
system = "none (no automated SPDX lint script or CI job found in this directory or wired to it)"
status = "pass"
evidence = "grep -rl 'SPDX-License-Identifier' across state-a2ml/ shows headers present in all lib/*.scm, spec/STATE-FORMAT-SPEC.adoc, spec/abnf/state.abnf, manifest.scm, channels.scm, .machine_readable/6a2/*.a2ml, .gitlab-ci.yml, .gitattributes, .gitignore, examples/example-state.scm."
effects = "Downstream re-users and SPDX/REUSE tooling can attribute licensing per-file without manual investigation."

[[must]]
id = "M3"
text = "A LICENSE file MUST exist in the spec directory matching the license(s) declared in its README/spec headers."
system = "none"
status = "fail"
effects = "README.adoc badge claims 'License: PMPL-1.0'; spec/README.adoc claims dual MIT + LicenseRef-Palimpsest-0.8 and points to '../LICENSE.txt'; source headers say 'MPL-2.0' or 'MPL-2.0 AND LicenseRef-Palimpsest-0.8'. No LICENSE.txt (or LICENSE) file exists inside state-a2ml/ at all — only a repo-root LICENSE exists, and it is unclear whether it covers this subtree's stated dual license. Consumers cannot determine the actual license terms for this spec without maintainer clarification."

[[must]]
id = "M4"
text = "Parsers of the format MUST reject files with an unsupported major format-version and MUST validate required sections/fields (per spec/STATE-FORMAT-SPEC.adoc Parsing Requirements and spec/VERSION-POLICY.adoc)."
system = "none"
status = "fail"
effects = "No reference parser or CLI validator ships in the repo (lib/*.scm provides accessors like get-section, query-by-status, etc., assuming a well-formed Scheme association-list is already loaded, but performs no schema/version validation). Any repo consuming STATE.a2ml files has no way to verify conformance before use, risking silent misparse of malformed or version-incompatible files."

[[must]]
id = "M5"
text = "The CI pipeline that lints/tests the Guile reference library MUST actually run against files that exist in the repository."
system = ".gitlab-ci.yml lint stage: `for f in lib/*.scm STATE.scm examples/*.scm; do guile -c \"(load \\\"$f\\\")\\\" ...`"
status = "fail"
effects = "The lint job iterates over `STATE.scm` at repo root, but no such file exists in state-a2ml/ (only the deprecated example lives at examples/example-state.scm and the current data file is .machine_readable/6a2/STATE.a2ml, not a .scm file). Running this job as written would fail on the missing glob target or silently skip it depending on shell globbing behavior, so the 'lint' guarantee is not actually being exercised as documented. Additionally, this pipeline is GitLab CI/CD (.gitlab-ci.yml) inside a repo whose real CI is GitHub Actions (root .github/workflows/*); there is no evidence this pipeline is ever triggered in the hyperpolymath/standards GitHub monorepo, meaning the described lint/test/build stages are effectively dead configuration."

[[should]]
id = "S1"
text = "The spec SHOULD ship comprehensive user-facing documentation covering usage, recipes, and citation guidance."
system = "none (manual review of docs/ directory)"
status = "pass"
evidence = "docs/USAGE.adoc (333 lines), docs/COOKBOOK.adoc (794 lines), docs/CITATIONS.adoc (55 lines) all exist and are substantial, non-stub content covering the format's intended usage patterns."
effects = "Users adopting STATE.a2ml have working reference material; absence would raise the barrier to correct adoption."

[[should]]
id = "S2"
text = "The reference Guile implementation SHOULD have automated tests (beyond 'module loads without error') exercising its accessor/query/graph/history functions against representative data."
system = "none — .gitlab-ci.yml 'test' stage only asserts that each module can be use-module'd and prints a static string; no assertions on function outputs, no test framework (no tests/ directory, no unit test files anywhere in the tree)"
status = "fail"
effects = "Regressions in query logic (query-by-status, dependency-chain-o, velocity calculations, DOT/Mermaid generation) in lib/state-*.scm would not be caught by CI; consumers embedding this library get no correctness guarantee beyond syntactic loadability."

[[should]]
id = "S3"
text = "Documented serialization bindings (JSON, YAML) referenced in spec/STATE-FORMAT-SPEC.adoc SHOULD have example artifacts or conversion tooling in the repo."
system = "none"
status = "fail"
effects = "spec/STANDARDS-TRACK.adoc and spec/README.adoc both reference converting STATE files to JSON for ajv-cli validation ('Requires conversion tool - see lib/ for implementation'), but no such conversion tool exists in lib/ (which contains only Guile accessor/query/graph/history modules, no JSON/YAML serializer). Users following the documented validation workflow will find it non-functional."

[[should]]
id = "S4"
text = "A SELF-ASSESSMENT.adoc or equivalent compliance self-report SHOULD exist for the spec, consistent with other specs in the monorepo."
system = "none"
status = "fail"
effects = "No SELF-ASSESSMENT.adoc found under state-a2ml/ (search confirmed absent), so there is no maintainer-authored baseline against which this scorecard or future audits can be cross-checked; the monorepo's governance workflows (governance-reusable.yml) rely on repo-wide artifacts like .hypatia-baseline.json rather than a per-spec self-assessment for this directory."

[[could]]
id = "C1"
text = "The format specification COULD advance through the documented standards track (IANA provisional registration, IETF Internet-Draft, RFC publication)."
system = "none — aspirational governance/external-body milestones tracked in spec/STANDARDS-TRACK.adoc"
status = "aspirational"
effects = "Until IANA/IETF submission occurs, the 'application/x-state+scheme' media type and RFC-style spec remain informal community documents with no external standing; downstream tooling cannot rely on an officially registered media type."

[[could]]
id = "C2"
text = "The spec COULD provide a minikanren-backed relational query engine as a genuinely optional, gracefully-degrading dependency."
system = "lib/state-kanren.scm: exposes minikanren-available?/fallback implementation; .gitlab-ci.yml 'test-kanren' job checks which path is active"
status = "pass"
evidence = "lib/state-kanren.scm defines kanren:minikanren-available? and lib/state.scm's state-modules-loaded reports 'loaded-with-minikanren or 'loaded-with-fallback depending on availability; .gitlab-ci.yml has a dedicated test-kanren job that exercises this branch."
effects = "Consumers without guile-minikanren installed still get correct (if less optimized) relational queries rather than a hard failure."

[[could]]
id = "C3"
text = "The spec COULD support multi-user/CRDT-based collaborative state merging (Tier 3.0 vision per VERSION-POLICY.adoc)."
system = "none"
status = "aspirational"
effects = "No effect on current single-user consumers; listed only as a v3.0 'Vision' item with no committed timeline, appropriately unreachable at present maturity."
