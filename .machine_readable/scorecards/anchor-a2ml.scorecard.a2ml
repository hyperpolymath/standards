# SPDX-License-Identifier: CC-BY-SA-4.0
# anchor-a2ml.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "anchor-a2ml"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "ANCHOR files MUST begin with SPDX license headers and an authority declaration (per spec/ANCHOR-FORMAT-SPEC.adoc, 'File Structure' / 'Header Comments')."
system = "none"
status = "manual-only"
effects = "Without an automated header/SPDX check, malformed or unlicensed ANCHOR files could be dropped into consumer repos undetected; SPDX/licence conformance is judged by governance/legal review, not tooling, per this repo's own convention (LICENSE-POLICY is manual across the monorepo)."

[[must]]
id = "M2"
text = "All ANCHOR.a2ml/.scm example and reference files in this repo MUST validate against the normative specification in spec/ANCHOR-FORMAT-SPEC.adoc."
system = "none"
status = "fail"
effects = "No parser, schema (JSON Schema/ABNF), or reference processor exists to check examples/minimal.scm, examples/comprehensive.scm against the spec; STATE.a2ml itself lists 'Add ABNF grammar', 'Add JSON Schema', and 'Reference ANCHOR processor implementation' as unfinished critical-next-actions, and there is no code in the repo that parses .scm/.a2ml ANCHOR content. Any consumer implementing an ANCHOR reader has no ground truth to test against."

[[must]]
id = "M3"
text = "All processing of ANCHOR files by an implementation MUST be logged for security/audit review (spec 'Security Considerations')."
system = "none"
status = "manual-only"
effects = "This is a requirement on downstream implementations (not on this spec repo itself), so it cannot be discharged by CI here; conformance can only be judged by manual audit of any implementing tool. Consumers building an ANCHOR processor must self-certify logging behaviour."

[[must]]
id = "M4"
text = "The repo MUST provide a single, internally consistent normative specification of the ANCHOR format (one canonical syntax/extension)."
system = "none"
status = "fail"
effects = "README.adoc's Quick Start shows ANCHOR content in TOML syntax with a '.a2ml' file name (e.g. '[anchor.authority.superintendent]'), while spec/ANCHOR-FORMAT-SPEC.adoc normatively defines ANCHOR.scm as Scheme s-expressions (define-module, define authority ...) with a '.scm' extension. These two documents describe incompatible syntaxes for the same artifact. Any tool built from the README examples would not conform to the spec, and vice versa — this is a genuine, uncorrected inconsistency at the heart of the spec, not just a stylistic gap."

[[must]]
id = "M5"
text = "Example files under examples/ MUST be genuine, runnable/parseable examples of the format they claim to illustrate."
system = "none"
status = "fail"
effects = "examples/minimal.scm and examples/comprehensive.scm are well-formed Scheme matching the .scm spec, but examples/web-project-deno.json is an unrelated Deno/ReScript project-config example with no connection to ANCHOR semantics, and there is no ANCHOR '.a2ml'-syntax example matching the README's TOML quick-start. A newcomer following the README examples cannot find a matching example file, and web-project-deno.json appears to be misplaced boilerplate from another template."

[[should]]
id = "S1"
text = "AI agents SHOULD check for ANCHOR files at session start, when directed to root or .machine_readable, and after 'anchor'/'realign' commands (spec 'Execution Protocol')."
system = "none"
status = "manual-only"
effects = "This governs behaviour of external AI-agent tooling, not this repo; no CI check applies. Downstream agent integrations must independently verify they implement this discovery behaviour."

[[should]]
id = "S2"
text = "ANCHOR files SHOULD have expiration dates, and expired ANCHORs SHOULD be treated as advisory only (spec 'Security Considerations')."
system = "none"
status = "manual-only"
effects = "No validator enforces presence of an 'expires' field or checks expiry against the current date; behaviour depends entirely on a conforming implementation's own logic, reviewed manually."

[[should]]
id = "S3"
text = "The repository SHOULD supply the 'contractiles' operational/trust/recovery framework wired into this repo's own layout (per contractiles/README.adoc's fill-in instructions) rather than leaving it as an unfilled generic template."
system = "/home/user/standards/audit-contractiles.sh (checks for .machine_readable/contractiles/{must,trust,dust,bust,adjust,intend})"
status = "fail"
effects = "Running audit-contractiles.sh against this repo reports '❌ No contractiles directory' and '❌ K9 missing' because contractiles/ lives at repo root (contractiles/must/Mustfile, contractiles/dust/Dustfile) rather than under .machine_readable/contractiles/, and only 'must' and 'dust' are present (trust/bust/adjust/intend absent, and Trustfile.hs/Intentfile mentioned in contractiles/README.adoc do not exist on disk). Any monorepo-wide contractile audit will flag this spec as non-compliant; downstream tooling relying on the audit script's monorepo-standard path will not find this repo's contractile files at all."

[[should]]
id = "S4"
text = "FFI bindings provided for the format SHOULD be a working, project-specific implementation rather than an unfilled template."
system = "none"
status = "fail"
effects = "ffi/zig/src/main.zig, build.zig and test/integration_test.zig are entirely templated with literal '{{project}}'/'STANDARDS' placeholders (e.g. 'export fn {{project}}_init()') and reference a nonexistent 'src/abi/Foreign.idr' Idris2 ABI — this is uncompiled, unrunnable boilerplate, not an anchor-a2ml FFI. Any consumer expecting a usable Zig binding for ANCHOR parsing will find none; 'zig build test' would fail to even parse given the template placeholders."

[[should]]
id = "S5"
text = "The CI pipeline (.gitlab-ci.yml) SHOULD exercise checks relevant to this repo's actual content (AsciiDoc/Scheme validation, contractile audit, example validation)."
system = ".gitlab-ci.yml (GitLab CI: trivy, gitleaks, semgrep, cargo-*, mix-* stages)"
status = "fail"
effects = "The pipeline is a generic Rust/Elixir template — cargo-test/cargo-build/mix-test/etc. all have 'rules: exists: Cargo.toml' or 'mix.exs', neither of which exists anywhere in anchor-a2ml, so those jobs never run. Only the language-agnostic filesystem scanners (trivy, gitleaks, semgrep) would actually execute; nothing validates the Scheme examples, AsciiDoc spec, or ANCHOR-specific semantics. Consumers cannot trust CI as a signal that this repo's actual deliverables (the spec and examples) are sound."

[[could]]
id = "C1"
text = "The project COULD reach 'production'/'stable' maturity with STATE.a2ml completion-percentage at 100 and a released v1.0.0 per ROADMAP.adoc."
system = "none"
status = "aspirational"
effects = "This is an intentionally-distant target; STATE.a2ml self-reports maturity='experimental', completion-percentage=50, and ROADMAP.adoc shows all v0.1.0 and v1.0.0 checklist items unchecked. No downstream consumer should treat this spec as stable today."

[[could]]
id = "C2"
text = "The project COULD provide a companion CITATIONS.adoc that is specific to anchor-a2ml (BibTeX/Harvard/APA entries naming this project) rather than a generic template."
system = "none"
status = "fail"
effects = "docs/CITATIONS.adoc is verbatim RSR-template-repo boilerplate (title 'RSR-template-repo', url pointing at github.com/hyperpolymath/RSR-template-repo) with no anchor-a2ml-specific citation data — anyone trying to cite this spec formally gets the wrong project name and URL."

[[could]]
id = "C3"
text = "The project COULD supply a reference ANCHOR processor/validator implementation as called for in STATE.a2ml's critical-next-actions."
system = "none"
status = "aspirational"
effects = "This is explicitly a forward-looking, not-yet-scoped deliverable (listed as a future action, not a current gap in delivered scope); until it exists, no automated conformance testing of third-party ANCHOR readers is possible."
