# SPDX-License-Identifier: CC-BY-SA-4.0
# ecosystem-a2ml.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "ecosystem-a2ml"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "ECOSYSTEM.a2ml documents MUST declare version, name, type, and purpose as required fields, and this MUST be captured in a formal machine-checkable schema."
system = "spec/ecosystem.schema.json (\"required\": [\"version\", \"name\", \"type\", \"purpose\"])"
status = "pass"
evidence = "/home/user/standards/ecosystem-a2ml/spec/ecosystem.schema.json line 7 declares required: [\"version\",\"name\",\"type\",\"purpose\"], matching README.adoc's \"Required Fields\" table."
effects = "Consumers building parsers/validators around this schema can rely on these four fields always being present; if unmet, downstream tooling (linters, dependency-mapping generators) would need defensive null-checks."

[[must]]
id = "M2"
text = "The specification's normative artefacts (grammar, JSON Schema, IANA considerations, Internet-Draft, family spec) MUST describe the same format that the README documents (a TOML-like A2ML key-value syntax, media type application/vnd.ecosystem+a2ml)."
system = "none"
status = "fail"
effects = "spec/ecosystem.abnf, spec/family/scm-core.abnf, spec/IANA-CONSIDERATIONS.adoc, and spec/draft/draft-jewell-ecosystem-scm-00.txt all describe a completely different format ('ECOSYSTEM.scm', an S-expression syntax, media type application/vnd.ecosystem+scm) rather than the TOML-like A2ML format the README describes. This is an unmigrated fork of the sibling repo rhodium-standard-repositories/satellites/ECOSYSTEM.scm/ (byte-for-byte matching schema/draft/roadmap file paths were found there). Any consumer, IANA registrar, or IETF reviewer reading the normative spec/ files would build tooling for the wrong syntax entirely; the README example (TOML) would fail against the actual grammar (S-expression)."

[[must]]
id = "M3"
text = "A machine-readable JSON Schema MUST exist to validate the JSON representation of conformant ECOSYSTEM.a2ml documents."
system = "spec/ecosystem.schema.json (2020-12 draft JSON Schema with typed properties, patterns for semver, enums)"
status = "pass"
evidence = "/home/user/standards/ecosystem-a2ml/spec/ecosystem.schema.json exists, is well-formed JSON Schema (draft 2020-12), and defines version/name/type/purpose plus optional properties (family, position-in-ecosystem, related-projects, etc.) matching the README's documented field set."
effects = "Downstream tooling (a2ml-to-json converters, CI validators in consuming repos) depends on this schema being present and internally coherent to validate ecosystem manifests at scale."

[[must]]
id = "M4"
text = "The repository MUST ship at least one genuine, schema-valid ECOSYSTEM.a2ml example document distinct from the inline README snippet."
system = "none"
status = "fail"
effects = "examples/web-project-deno.json is a Deno tasks/imports config file for a ReScript project, unrelated to the ECOSYSTEM.a2ml format (no version/name/type/purpose keys, not TOML/A2ML content matching the spec at all). New adopters following the README's Quick Start have no real example file to copy or to validate against the schema/CI, only the inline prose snippet."

[[must]]
id = "M5"
text = "The specification MUST carry an unambiguous SPDX/licence declaration (Palimpsest-MPL License v1.0)."
system = "none (licence rulings are always human/governance judgement)"
status = "manual-only"
effects = "Consumers and re-distributors need a governance-confirmed licence determination before relying on or forking the format; automated SPDX header scanning alone cannot certify licence applicability/compatibility."

[[should]]
id = "S1"
text = "The spec directory SHOULD contain a SELF-ASSESSMENT.adoc tracking its own compliance/maturity status against the monorepo's standards."
system = "none"
status = "fail"
effects = "Reviewers and downstream consumers (e.g. the monorepo's own compliance scorecard tooling) cannot see a first-party self-assessment; they must infer maturity solely from README claims, which are shown above to be unreliable (see M2, M4)."

[[should]]
id = "S2"
text = "The spec SHOULD have CI that lints/validates the grammar, JSON Schema, and any example documents on every push (e.g. schema self-validation, ABNF syntax check, or example-vs-schema conformance test)."
system = "none"
status = "fail"
effects = "No .github/workflows exist under ecosystem-a2ml/, and no repo-root workflow (.github/workflows/*.yml) references ecosystem.schema.json, ecosystem.abnf, or this directory. The M2 scm/a2ml mismatch and the M4 wrong-example issue would have been caught immediately by even a minimal CI check, and none exists to catch regressions going forward."

[[should]]
id = "S3"
text = "Governance contractiles (Mustfile/Dustfile/Trustfile/Intentfile under contractiles/) SHOULD be filled in with this project's real invariants rather than left as generic templates."
system = "none (root scripts/check-mustfile-structure.sh and scripts/run-mustfile.sh default to .machine_readable/contractiles/must/Mustfile.a2ml at repo root and are not wired to ecosystem-a2ml/contractiles/must/Mustfile, which uses a different path/naming convention)"
status = "fail"
effects = "contractiles/must/Mustfile still contains the literal template checks (config-valid, gateway-exposes-port, etc.) unrelated to an A2ML spec repo, and .machine_readable/6a2/ECOSYSTEM.a2ml has empty purpose/role/category fields and 'No related projects recorded' — none of it reflects real invariants, so the framework provides no actual governance signal for this repo, and the monorepo's boj-build.yml CI job validates only the top-level repo's own contractiles, not this subdirectory's."

[[should]]
id = "S4"
text = "Repository-level governance files that the README's 'Project Structure' section lists as present in ecosystem-a2ml/ (CONTRIBUTING.md, CODE_OF_CONDUCT.md, SECURITY.md, LICENSE) SHOULD actually exist at that stated path."
system = "none"
status = "fail"
effects = "A contributor following the README's tree diagram (which places CONTRIBUTING.md/CODE_OF_CONDUCT.md/SECURITY.md/LICENSE directly under ecosystem-a2ml/) will find none of those files there; only monorepo-root equivalents exist (/home/user/standards/CONTRIBUTING.md etc.), which may or may not apply identically to this subproject's PMPL-1.0 licence claim."

[[could]]
id = "C1"
text = "A reference CLI validator/parser COULD be provided to convert and validate ECOSYSTEM.a2ml files against the JSON Schema, replacing the README's placeholder 'hypothetical a2ml-to-json tool' command."
system = "none"
status = "fail"
effects = "Without a real validator, the 'Validate (Optional)' Quick Start step in README.adoc cannot actually be executed by any adopter; ecosystem manifests can drift from the schema with no way to detect it locally."

[[could]]
id = "C2"
text = "Standard citation metadata (CITATION.cff, codemeta.json) COULD be provided so the spec can be formally cited."
system = "none"
status = "fail"
effects = "docs/CITATIONS.adoc links to '../CITATION.cff' and '../codemeta.json', neither of which exists in ecosystem-a2ml/; the citations doc itself is unedited RSR-template-repo boilerplate (title 'RSR-template-repo', author 'Polymath, Hyper') rather than content specific to ECOSYSTEM.a2ml, so academic/tooling consumers get broken links and wrong metadata if they try to cite this spec."

[[could]]
id = "C3"
text = "ECOSYSTEM.a2ml (as part of the coordinated A2ML/SCM family submission) COULD progress through IETF adoption to a published Informational RFC with IANA media-type registration."
system = "none (external IETF process, not automatable)"
status = "aspirational"
effects = "Formal IETF/IANA registration would let downstream tools (content-type sniffers, package registries) recognise application/vnd.ecosystem+a2ml as a registered media type; until then, ecosystems relying on it do so on an ad hoc, non-standardised basis."
