# SPDX-License-Identifier: CC-BY-SA-4.0
# neurosym-a2ml.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "neurosym-a2ml"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "NEUROSYM files and the spec document MUST carry SPDX-License-Identifier / SPDX-FileCopyrightText headers (spec.adoc, Header Comments section; README.adoc Contributing section)."
system = "none — no automated SPDX-header-presence checker is wired into this repo home (scripts/check-licence-consistency.sh checks LICENSE-file identity, not per-file headers, and is only invoked by governance-reusable.yml for callers that have their own .github/workflows, which neurosym-a2ml/ does not)"
status = "manual-only"
effects = "Licensing/attribution defensibility for downstream consumers of the A2ML Format Family; always a human/legal judgement, never purely mechanical."

[[must]]
id = "M2"
text = "Operation definitions MUST include all required fields (forward-semantics, inverse, claim-type, entropy-contribution, preconditions, postconditions) as stated in the Conformance section of spec/NEUROSYM-FORMAT-SPEC.adoc."
system = "none — no schema/CLI validator exists in this repo to check operation-definitions blocks against the required-field list; ncl/lib/schema.ncl only encodes the generic Rhodium Project/Deployment schema, not NEUROSYM fields"
status = "fail"
effects = "PLAYBOOK.a2ml and AGENTIC.a2ml consumers that rely on NEUROSYM operation semantics have no automated guarantee that a project's NEUROSYM file is well-formed before those pipeline stages run."

[[must]]
id = "M3"
text = "Failure to discharge a proof obligation MUST downgrade the associated claim; claims MUST NOT be silently preserved at a higher level than proven (spec Security Considerations / Proof Discharge sections)."
system = "none — no reference semantic evaluator/enforcement implementation exists in the repo; STATE.a2ml (.machine_readable/6a2/STATE.a2ml) lists \"Reference semantic evaluator implementation\" as an outstanding critical-next-action, confirming this is unimplemented, not just untested"
status = "fail"
effects = "Any consumer (AGENTIC, PLAYBOOK, STATE integrity checks) that treats a NEUROSYM claim as trustworthy has no enforced guarantee the claim was actually downgraded on proof failure; risk of silent over-claiming propagating downstream."

[[must]]
id = "M4"
text = "Composition rules MUST preserve or downgrade claim types across sequential/parallel/conditional composition, never upgrade them without explicit proof (spec Composition Rules / Conformance sections)."
system = "none — composition-rules are documented in prose and in examples/comprehensive.a2ml but there is no evaluator or test that exercises sequential/parallel/conditional composition and checks claim-type propagation"
status = "fail"
effects = "Composed operations built on top of NEUROSYM semantics (e.g. PLAYBOOK-derived multi-step plans) cannot be mechanically trusted not to silently upgrade an unverified/compensable claim to verified."

[[must]]
id = "M5"
text = "The spec's home directory, canonical doc, and content hash MUST be correctly registered in the estate spec registry so downstream tooling (TOPOLOGY.md, drift detection) can locate it."
system = "scripts/build-registry.sh --check, run as the \"Registry + topology in sync\" job in .github/workflows/registry-verify.yml"
status = "pass"
evidence = "/home/user/standards/.machine_readable/REGISTRY.a2ml lines 97-103 contain a `[[spec]]` entry with id=\"neurosym-a2ml\", home=\"neurosym-a2ml/\", canonical_doc=\"neurosym-a2ml/README.adoc\", and a computed source_hash; /home/user/standards/TOPOLOGY.md line 29 lists the corresponding human-readable row — both are consistent with the current file tree."
check = "bash scripts/build-registry.sh --check"
effects = "Estate-wide tooling (drift detection, Hypatia rule HYP-S006, cross-repo navigation) depends on this registry entry staying accurate; it currently is."

[[should]]
id = "S1"
text = "The format SHOULD have a formal grammar (e.g. ABNF/EBNF) defining valid NEUROSYM.a2ml syntax, beyond prose description."
system = "none"
status = "fail"
effects = "Parser/tooling authors for other A2ML-family specs (a2ml/ CLI, playbook-a2ml) have no formal grammar to implement against, relying on the TOML-like examples and prose alone; increases risk of divergent parsers."

[[should]]
id = "S2"
text = "The format SHOULD ship a machine-checkable JSON Schema (or equivalent) for validating NEUROSYM.a2ml files."
system = "none — STATE.a2ml (.machine_readable/6a2/STATE.a2ml, critical-next-actions) explicitly lists \"Add JSON Schema\" as not yet done"
status = "fail"
effects = "Consumers cannot programmatically validate a NEUROSYM.a2ml file before feeding it into AGENTIC/PLAYBOOK pipeline stages; validation is manual/eyeball only."

[[should]]
id = "S3"
text = "The shipped examples (examples/minimal.a2ml, examples/comprehensive.a2ml) SHOULD validate against the normative spec via an automated check, per README.adoc's Contributing statement \"Examples validate against the spec\"."
system = "none in this repo — a validate-a2ml.sh / a2ml CLI validator exists in the sibling a2ml/ repository (a2ml/actions/validate/validate-a2ml.sh, a2ml/.github/workflows/a2ml-validation.yml) but is not wired into neurosym-a2ml/ (no .github/workflows directory here at all; only a generic .gitlab-ci.yml with Rust/Elixir gates that do not fire, since there is no Cargo.toml or mix.exs)"
status = "fail"
effects = "The Contributing guideline in README.adoc (\"Examples validate against the spec\") is currently unenforced; a spec change or example drift would go undetected."

[[should]]
id = "S4"
text = "The repository SHOULD carry a SECURITY.md, per estate governance convention (checked elsewhere in the estate by scorecard-enforcer.yml's check-critical job)."
system = "none wired here — .github/workflows/scorecard-enforcer.yml's check-critical job asserts SECURITY.md exists, but that workflow lives at the monorepo root / is intended for satellite repos with their own workflow call-in; neurosym-a2ml/ has no .github/workflows and no SECURITY.md"
status = "fail"
effects = "GitHub security-tab guidance and the estate scorecard consider this spec incomplete on baseline governance hygiene; COMPLIANCE-DASHBOARD.md already flags neurosym-a2ml as \"no scorecard\"."

[[could]]
id = "C1"
text = "README.adoc COULD be supplemented/replaced by README.md per the estate-wide Markdown-for-community-health migration policy."
system = "none scoped to this directory — .github/workflows/doc-format.yml implements this exact check (\"README.adoc without README.md\" warning) but only checks files at whichever repo root it runs against; it is not currently exercised against neurosym-a2ml/README.adoc"
status = "fail"
effects = "GitHub community-health tab, GitHub profile, and external MCP directories (Glama) would render this repo's README as raw AsciiDoc rather than formatted Markdown if/when neurosym-a2ml is split into its own GitHub repo."

[[could]]
id = "C2"
text = "The project COULD ship a reference semantic evaluator that mechanically discharges proof obligations and enforces claim-type downgrade/composition rules end-to-end, going beyond the current prose-only specification."
system = "none"
status = "aspirational"
effects = "Without a reference evaluator, every downstream consumer must independently implement proof-discharge and composition-safety logic, risking divergent/incorrect implementations across the A2ML Format Family."

[[could]]
id = "C3"
text = "Cross-links to sibling A2ML Format Family repos in README.adoc (meta-a2ml, playbook-a2ml, agentic-a2ml, anchor-a2ml) COULD be verified by an automated link-checker."
system = "test -d checks (run from repo root) confirming each linked sibling-repo directory (meta-a2ml/, playbook-a2ml/, agentic-a2ml/, anchor-a2ml/) referenced from neurosym-a2ml/README.adoc's cross-links actually exists; this is an enforcement-gap fix (the links are correct today, just previously unchecked), not a full markdown-link-checker."
status = "pass"
evidence = "neurosym-a2ml/README.adoc contains relative AsciiDoc cross-links link:../meta-a2ml/[...], link:../playbook-a2ml/[...], link:../agentic-a2ml/[...], link:../anchor-a2ml/[...]; verified with `grep -oP 'link:\\.\\./[a-z0-9-]+/' neurosym-a2ml/README.adoc` that these are exactly the four sibling repo names, and `test -d` against each from the repo root confirms all four targets exist on disk today."
check = "test -d meta-a2ml && test -d playbook-a2ml && test -d agentic-a2ml && test -d anchor-a2ml"
effects = "Broken relative links to sibling spec repos would not be caught automatically, degrading navigability of the A2ML Format Family documentation set."
