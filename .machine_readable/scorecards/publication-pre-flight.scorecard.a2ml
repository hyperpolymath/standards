# publication-pre-flight.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "publication-pre-flight"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "Every hyperpolymath paper MUST pass the 10-P checklist (Present, Purpose, Precedent, Performant, Profiled, Probed, Proven, Portable, Production, Publication) before submission to Zenodo, HAL, arXiv, or any venue."
system = "none"
status = "manual-only"
effects = "If unmet, downstream papers/whitepapers (e.g. artefacts listed in ESTATE-AUDIT-BASELINE-2026-03-30.adoc such as 007-lang, typed-wasm, valence-shell, wokelang) risk premature submission with unverified claims, damaging the reputation of all hyperpolymath publications and any repo that cites them."

[[must]]
id = "M2"
text = "Proof code MUST contain zero dangerous escape hatches (believe_me, sorry, Admitted, assert_total, postulate, unsafeCoerce, Obj.magic) except documented crypto axioms, checkable via grep -r."
system = "none — PREFLIGHT.adoc specifies the grep pattern (line 101) as a manual/CI-able check, but no script or workflow in this spec directory actually runs it for candidate papers"
status = "fail"
effects = "Any consuming paper repo (proof-heavy repos flagged in the estate audit: Axiom.jl, ProvenCrypto.jl, aspasia) could ship with hidden escape hatches undetected, undermining the 'Proven' P and misrepresenting proof status to reviewers/DOI consumers."

[[must]]
id = "M3"
text = "Benchmarks and tests MUST be authentic — no placeholder harnesses, black_box(42), copied template benches, or scaffold tests counted as evidence (PREFLIGHT.adoc sections 1-2)."
system = "none"
status = "fail"
effects = "Downstream artefacts could retain template contamination (as the estate audit baseline itself warns), causing Zenodo/HAL deposits and CI badges to misrepresent actual test/benchmark coverage."

[[must]]
id = "M4"
text = "A .zenodo.json MUST be present in the repo root of any archival-release candidate with title, description, creators, keywords, subjects, and licence metadata (ZENODO-DEPOSIT-CHECKLIST.adoc section 1)."
system = "none — no .zenodo.json exists at the monorepo root (verified via ls), and this spec directory contains no script that would generate or validate one"
status = "fail"
effects = "Any Zenodo deposit attempted today would lack machine-readable metadata, blocking DOI minting and downstream citation/discovery for any paper repo depending on this checklist."

[[must]]
id = "M5"
text = "Every theorem stated in a paper MUST have a machine-checked proof in the repo, or be explicitly labelled 'Conjecture' if unproven (PREFLIGHT.adoc section 3, HOL-SUITABILITY-CHECKLIST.adoc section 1)."
system = "none"
status = "manual-only"
effects = "Consuming proof-heavy repos (Idris2/Lean4/Agda projects referenced in the estate audit) risk paper/proof parity violations that only human review of the Proof coverage / HOL Suitability checklist can catch."

[[should]]
id = "S1"
text = "The repo SHOULD contain a Hypatia scan cache (.hypatia/ directory) reflecting a recent static-analysis pass (PREFLIGHT.adoc section 2)."
system = "none for this spec directory itself; a top-level .hypatia directory exists in the monorepo root, but publication-pre-flight/ has no self-scan and no script tying candidate papers to a fresh Hypatia run"
status = "fail"
effects = "Candidate paper repos lacking their own .hypatia/ cache would fail this SHOULD, weakening confidence in the 'Probed' P for any paper relying on this checklist."

[[should]]
id = "S2"
text = "A reviewer SHOULD be able to clone the repo, run the tests, and verify claims in under 30 minutes; if not, a setup.sh SHOULD be provided (PREFLIGHT.adoc section 7)."
system = "none"
status = "manual-only"
effects = "Slow/complex reproducibility discourages reviewers and journal/DOI validators from checking claims in downstream paper repos, weakening trust in any archival deposit."

[[should]]
id = "S3"
text = "Estate-wide audit baselines (e.g. ESTATE-AUDIT-BASELINE-2026-03-30.adoc) SHOULD be periodically refreshed to track publication-surface triage across the monorepo."
system = "none — this is a single dated inventory document (2026-03-30) with no recurring script, cron, or CI job regenerating it"
status = "fail"
effects = "As new paper/whitepaper candidates are added elsewhere in the monorepo (e.g. new .tex or WHITEPAPER.md files), they will not be captured by this stale baseline, letting unaudited publication surface accumulate silently."

[[should]]
id = "S4"
text = "Dual deposit (both Zenodo DOI and HAL) SHOULD be pursued for maximum discoverability once a paper is release-ready (PREFLIGHT.adoc section 6, ZENODO-DEPOSIT-CHECKLIST.adoc section 4)."
system = "none"
status = "manual-only"
effects = "Papers that skip HAL after Zenodo lose French national-archive discoverability; this is a judgement/workflow call with no automatable gate."

[[could]]
id = "C1"
text = "The standard COULD eventually be enforced by an automated CI job that runs the grep-based dangerous-pattern, template-contamination, and benchmark-authenticity checks (PREFLIGHT.adoc sections 1-2) against any repo before it is tagged vX.Y.Z-paper."
system = "none"
status = "aspirational"
effects = "Without such CI, enforcement of the entire pre-flight standard remains fully manual across every consuming paper repo in the monorepo; this reach target would close that gap."

[[could]]
id = "C2"
text = "Cross-validation of key theorems in a second prover (e.g. Lean4 alongside Idris2) COULD be required for HOL-suitability-grade papers (HOL-SUITABILITY-CHECKLIST.adoc, PREFLIGHT.adoc section 3)."
system = "none"
status = "aspirational"
effects = "Raises proof confidence for theorem-grade papers beyond what a single prover backend guarantees; not required today for any repo in the estate."
