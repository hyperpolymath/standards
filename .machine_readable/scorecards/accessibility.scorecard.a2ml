# accessibility.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "accessibility"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "The spec MUST provide a machine-readable Adjustfile.a2ml contract at .machine_readable/contractiles/adjust/Adjustfile.a2ml to satisfy Level A minimum viability."
system = "probe: test -f .machine_readable/contractiles/adjust/Adjustfile.a2ml (as literally defined in STANDARD.a2ml Level A section)"
status = "pass"
evidence = "/home/user/standards/.machine_readable/contractiles/adjust/Adjustfile.a2ml exists on disk (along with sibling adjust.manifest.a2ml, adjust.ncl, adjust.k9.ncl in the same directory)."
effects = "Downstream projects copying this standard rely on this file as the canonical contractile template; if missing, their own Level-A probe fails."

[[must]]
id = "M2"
text = "Projects MUST implement keyboard navigation for all functionality (Level A)."
system = "probe in STANDARD.a2ml: test -f accessibility/keyboard.ex || find . -name \"*keyboard*\" -type f — but this is a per-consumer-project probe, not something the standards repo itself implements"
status = "fail"
effects = "Consuming projects (e.g. the example 'Burble' project referenced in docs/accessibility/README.adoc) cannot claim Level A compliance without their own implementation; the standards repo itself ships no reference implementation or fixture proving the probe works."

[[must]]
id = "M3"
text = "Projects MUST provide accessibility documentation (docs/accessibility/README.adoc) per Level A 'documentation' requirement."
system = "probe: test -f docs/accessibility/README.adoc"
status = "pass"
evidence = "/home/user/standards/docs/accessibility/README.adoc exists and documents keyboard, screen-reader, and roadmap sections (though it is written as a template for a hypothetical 'Burble' project, not the standards repo itself)"
effects = "If absent, any project claiming HAS Level A compliance has no discoverable documentation trail, undermining auditability."

[[must]]
id = "M4"
text = "Projects MUST provide visible focus indicators (CSS focus styles) for Level A keyboard accessibility."
system = "probe: grep -r \"focus\\|:focus\" . — this is a generic grep with no fixture or CI enforcement anywhere in the repo"
status = "fail"
effects = "No verifiable evidence exists in the standards repo of a passing focus-indicator check; any downstream claim of compliance is unverified."

[[must]]
id = "M5"
text = "Projects MUST support configurable/remappable keyboard shortcuts (Level A)."
system = "probe: grep -r \"keybindings\\|shortcuts\" . — generic text grep, no CI job or test asserting this in the repo"
status = "fail"
effects = "No mechanism in this repo enforces or verifies remappable shortcuts; consumers have no automated gate."

[[should]]
id = "S1"
text = "User-facing projects SHOULD achieve WCAG 2.1 AA compliance by Q4 2026, including automated accessibility testing (pa11y/axe-core) wired into CI."
system = "probe: grep -r \"pa11y\\|axe\\|accessibility\" .github/workflows/ — checked repo-wide"
status = "fail"
effects = "No CI job anywhere in /home/user/standards/.github/workflows references pa11y, axe, or accessibility; automated AA verification is entirely absent, so the Q4 2026 target has no tooling in place yet."

[[should]]
id = "S2"
text = "Projects SHOULD publish a VPAT 2.4-format compliance report at docs/compliance/ACCESSIBILITY.adoc."
system = "probe: test -f docs/compliance/ACCESSIBILITY.adoc"
status = "fail"
effects = "The file at /home/user/standards/docs/compliance/ACCESSIBILITY.adoc exists but is an unrendered template — it contains literal unexpanded shell expressions ($(basename \"$repo\"), $(date '+%Y-%m-%d')) rather than actual filled-in product/version/date fields, so it does not constitute a genuine completed VPAT for any real project; treating the probe's file-existence check as satisfied would overstate actual compliance."

[[should]]
id = "S3"
text = "Projects SHOULD provide high-contrast mode meeting a 4.5:1 contrast ratio target (Level AA visual accessibility)."
system = "probe: grep -r \"contrast\\|a11y-contrast\" . — no automated ratio-measurement tool present"
status = "fail"
effects = "No contrast-ratio tooling (e.g. axe-core color-contrast rule) is wired into CI; claims of 4.5:1 compliance are unverifiable."

[[should]]
id = "S4"
text = "Projects SHOULD respect prefers-reduced-motion for users with vestibular/motor sensitivities (Level AA)."
system = "probe: grep -r \"motion\\|animation\\|prefers-reduced-motion\" . — no fixture or CI check in this repo"
status = "fail"
effects = "No automated enforcement exists; any implementation compliance is asserted only in prose (docs/accessibility/README.adoc roadmap), not verified."

[[should]]
id = "S5"
text = "Manual testing (keyboard-only, screen reader, high contrast) SHOULD be documented per project at docs/testing/ACCESSIBILITY.adoc."
system = "probe: test -f docs/testing/ACCESSIBILITY.adoc"
status = "fail"
effects = "No such file exists anywhere in the repo (find returned nothing under docs/testing); manual-testing sign-off has no discoverable record."

[[could]]
id = "C1"
text = "Public websites COULD achieve WCAG 2.1 AAA enhanced compliance by 2027 (plain language mode, predictable navigation, error prevention with undo)."
system = "none — explicitly marked 'required: false' / aspirational in STANDARD.a2ml, target year 2027"
status = "aspirational"
effects = "No downstream impact expected before 2027; premature enforcement would block unrelated projects."

[[could]]
id = "C2"
text = "Projects COULD conduct user testing with a minimum of 5 diverse users with disabilities, quarterly."
system = "none — inherently a human/governance process; probe grep -r \"user-testing\\|usability\" docs/ only detects prose mentions, not actual test execution"
status = "manual-only"
effects = "Cannot be automated; relies on maintainer discipline and periodic governance review to confirm sessions actually occurred."

[[could]]
id = "C3"
text = "Projects COULD implement voice-command control interfaces as an alternative input modality (Level AA motor accessibility)."
system = "none — no implementation, fixture, or CI check exists in the repo"
status = "fail"
effects = "Users relying solely on voice control have no supported path in any project governed by this standard yet; low current impact since it is optional/AA-recommended rather than Level A."
