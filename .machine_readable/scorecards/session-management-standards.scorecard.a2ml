# SPDX-License-Identifier: CC-BY-SA-4.0
# session-management-standards.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "session-management-standards"
version = "1.0.0"
assessed_date = "2026-10-05"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "Every protocol directory MUST contain all four artefacts of the Protocol File Contract: CHECKLIST.adoc, PROTOCOL.yaml, STATE-template.a2ml, and EXAMPLE-FILLED-IN.adoc (README.adoc, 'Protocol File Contract')."
system = "none — no script enforces the file contract; verified manually via `find`."
status = "fail"
effects = "Only continuity/planned-session-close/ has an EXAMPLE-FILLED-IN.adoc (11 of the 12 protocol directories lack one: repo-intake, checkpoint-before-major-change, emergency-termination, recovery-operation, all four handover/* protocols, and all three verify/* protocols). Downstream repos and any assistant trying to follow a worked example for these 11 protocols have nothing concrete to copy from."

[[must]]
id = "M2"
text = "Every protocol MUST include a 'Verification' block per the format defined in SHARED-CONTINUITY-CORE.adoc ('Every protocol must include a Verification block specifying the mandatory checks required before the protocol declares success')."
system = "none"
status = "fail"
effects = "The 8 stub-status protocols (repo-intake, checkpoint-before-major-change, recovery-operation, collaborative-transfer, full-transfer, human-transfer, model-transfer, maintenance-sweep, release-audit — all with 52-line CHECKLIST.adoc and 23-line PROTOCOL.yaml) contain no Verification block. Consuming repos cannot mechanically confirm these protocols were executed correctly."

[[must]]
id = "M3"
text = "Every protocol MUST capture the full 'Enriched 25-Field Continuity Core' defined in SHARED-CONTINUITY-CORE.adoc across meta-attributes, core sections, commits table, verifications table, and discipline-check audit."
system = "none"
status = "fail"
effects = "Stub protocols' PROTOCOL.yaml/STATE-template.a2ml (e.g. continuity/repo-intake) list only 11 abbreviated fields (goal, current_task, last_completed_action, next_intended_action, repository, branch, head_commit, files_of_interest, known_blockers, residual_risks, recommended_next_protocol) — missing protocol-version, session-id/timestamps, commits-made table, verifications-run table, decisions/deferred, and the discipline-check audit. Downstream repos relying on the '25-field' continuity guarantee get materially incomplete state for 8 of 12 protocol families."

[[must]]
id = "M4"
text = "Every artefact in this directory (PROTOCOL.yaml, STATE-template.a2ml, *.adoc) MUST carry a valid SPDX-License-Identifier header per project-wide licensing convention."
system = "none — licence/SPDX compliance is a manual/governance judgement, not automated for this directory (no reuse-lint or SPDX CI job targets session-management-standards; `.githooks/validate-spdx.sh` covers the *.yaml files, but only from the optional pre-commit hook, and *.a2ml is outside its extension list)."
status = "manual-only"
evidence = "All 12 PROTOCOL.yaml files carry `# SPDX-License-Identifier: MPL-2.0` (the 11 added in the 2026-10-05 #B rename, when the files left the `.k9` suffix and entered the SPDX hook's *.yaml extension scope)."
effects = "19 of 51 tracked files lack an SPDX header: all 11 STATE-template.a2ml files outside planned-session-close, plus 8 of the 9 templates/*.adoc files (e.g. handover/full-transfer/STATE-template.a2ml and templates/SESSION_SUMMARY.adoc). The 12 PROTOCOL files the previous audit counted are fixed; provenance/licence status for the remaining 19 is ambiguous for anyone mirroring or redistributing them."

[[must]]
id = "M5"
text = "The 'Directory Map' and 'Canonical Protocol Families' enumerated in README.adoc MUST match the actual on-disk directory/file structure."
system = "none (no automated drift check), but verified pass by direct filesystem inspection."
status = "pass"
evidence = "All 12 protocol directories (verify/{maintenance-sweep,substantial-completion,release-audit}, continuity/{repo-intake,checkpoint-before-major-change,planned-session-close,emergency-termination,recovery-operation}, handover/{full-transfer,collaborative-transfer,model-transfer,human-transfer}) and all 9 templates/ files listed in the README Directory Map exist exactly as named on disk."
check = "for d in verify/maintenance-sweep verify/substantial-completion verify/release-audit continuity/repo-intake continuity/checkpoint-before-major-change continuity/planned-session-close continuity/emergency-termination continuity/recovery-operation handover/collaborative-transfer handover/full-transfer handover/human-transfer handover/model-transfer; do test -d \"3-practice/session-management-standards/$d\" || exit 1; done && for f in SESSION_STATE.adoc NEXT_STEPS.adoc SESSION_SUMMARY.adoc EMERGENCY-CHECKPOINT.adoc SUBSTANTIAL_COMPLETION_REPORT.adoc HANDOVER-REPORT.adoc RECOVERY-PLAN.adoc RELEASE_AUDIT.adoc MAINTENANCE_REPORT.adoc; do test -f \"3-practice/session-management-standards/templates/$f\" || exit 1; done"
effects = "n/a — this is currently sound, so no downstream impact."

[[should]]
id = "S1"
text = "Machine protocol contracts under this standard SHOULD stay off the reserved `.k9`/`.k9.ncl` suffixes unless they conform to a registered K9 dialect (K9-CONTRACT-SPEC.adoc §4.2, 'Extension reservation'); plain YAML contracts use `.yaml`."
system = "1-formats/k9/tools/k9-validate.sh — the canonical K9 validator; `.githooks/validate-k9.sh` scans every tracked `*.k9`/`*.k9.ncl` through it. 3-practice/session-management-standards/ contains none."
status = "pass"
evidence = "All 12 PROTOCOL.k9 stubs were renamed to PROTOCOL.yaml by migration item M2 / issue #B (ruled 2026-10-05) and left `.machine_readable/k9-contract-debt.txt` (17 entries → 5); the S1 check below grounds the pass."
check = "test -z \"$(git ls-files '3-practice/session-management-standards/*.k9' '3-practice/session-management-standards/*.k9.ncl')\""
effects = "n/a — resolved. Before the rename the 12 files produced an unclaimed-dialect error (K9-E005 ×12) and 11 missing-SPDX errors (K9-E004 ×11) against a suffix their bodies did not honour; renaming removes the false format promise for every reviewer, `file(1)` and future validator."

[[should]]
id = "S2"
text = "Retired protocol names (maintenance-check, planned-termination, handover-preparation) SHOULD NOT be referenced as live protocol names anywhere else in the monorepo, per README's 'Renamed Protocols' section."
system = "none"
status = "pass"
evidence = "grep across the monorepo (*.adoc, *.md) for 'maintenance-check', 'planned-termination', 'handover-preparation' returns no hits outside this directory's own README retirement notice."
check = "! grep -rn \"maintenance-check\\|planned-termination\\|handover-preparation\" --include=\"*.adoc\" --include=\"*.md\" . | grep -v \"^./3-practice/session-management-standards/README.adoc\" | grep -q ."
effects = "n/a — no stale cross-references found, so no downstream confusion currently."

[[should]]
id = "S3"
text = "adoption-and-integration-guide/GUIDE.adoc SHOULD provide a concrete, runnable example of the 'thin local binding' pattern (e.g. a sample Justfile recipe or session/custom-checks.k9 snippet) so downstream repos have something to copy."
system = "none"
status = "fail"
effects = "GUIDE.adoc only describes the binding pattern in prose ('Justfile aliases/recipes', 'coordination.k9 integration', 'session/custom-checks.k9') without showing any actual file content or command syntax. Downstream repo maintainers must invent the binding format from scratch, risking drift between repos' local integrations."

[[should]]
id = "S4"
text = "Protocols whose CHECKLIST.adoc has been substantially expanded (emergency-termination at 523 lines, substantial-completion at 300 lines) SHOULD have correspondingly expanded PROTOCOL.yaml/STATE-template.a2ml machine artefacts, not stub-level ones."
system = "none"
status = "fail"
effects = "continuity/emergency-termination/PROTOCOL.yaml is only 23 lines and its STATE-template.a2ml only 20 lines despite the checklist being fully written out; same pattern for verify/substantial-completion (23/20 lines). Any tooling meant to machine-drive these two protocols from PROTOCOL.yaml/STATE-template.a2ml would be working from stub-level data despite the checklists implying full protocol maturity — a documentation/implementation mismatch."

[[could]]
id = "C1"
text = "The repo COULD include a real downstream binding example (e.g. an actual Justfile or session/local-hooks.sh sample) demonstrating the 'Minimal Local Binding Strategy' from GUIDE.adoc."
system = "none"
status = "fail"
effects = "Repos adopting this standard have no reference implementation to validate their local bindings against, increasing onboarding friction and risk of divergent interpretations across the estate."

[[could]]
id = "C2"
text = "templates/ COULD include at least one fully filled-in example per template (mirroring continuity/planned-session-close/EXAMPLE-FILLED-IN.adoc) rather than only blank field-attribute skeletons."
system = "none"
status = "fail"
effects = "Authors filling in SESSION_STATE.adoc, HANDOVER-REPORT.md, etc. for the first time have no worked example beyond the one that exists for planned-session-close, increasing the chance of inconsistent field usage across protocol families."

[[could]]
id = "C3"
text = "An automated CI job COULD periodically diff README.adoc's Directory Map / status claims ('Current Status' section) against the actual file contents to catch drift as protocols are expanded or renamed."
system = "none — no such job exists in .github/workflows/."
status = "aspirational"
effects = "Without this, README status claims (e.g. 'Remaining protocol files are present as explicit stubs') could silently go stale as individual protocols are expanded, without any automated signal to update the README."
