# SPDX-License-Identifier: CC-BY-SA-4.0
# meta-a2ml.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "meta-a2ml"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "The repository MUST provide a formal specification document defining the META.a2ml/META format syntax and semantics."
system = "spec/META-FORMAT-SPEC.adoc (present, IETF Internet-Draft style)"
status = "pass"
evidence = "/home/user/standards/meta-a2ml/spec/META-FORMAT-SPEC.adoc exists with Abstract, Status of Memo, Introduction, ABNF cross-references, etc."
check = "test -f meta-a2ml/spec/META-FORMAT-SPEC.adoc && grep -q 'Abstract' meta-a2ml/spec/META-FORMAT-SPEC.adoc && grep -q 'Status of' meta-a2ml/spec/META-FORMAT-SPEC.adoc"
effects = "Consumers/implementers (parsers, tooling, sibling *-a2ml repos) rely on this doc as the normative reference."

[[must]]
id = "M2"
text = "The formal grammar (ABNF), the JSON Schema, the README's usage examples, and the examples/ directory MUST describe the same file format."
system = "none (no CI job cross-validates spec/abnf/meta.abnf, spec/schema/meta.schema.json, README.adoc examples, and examples/*.a2ml against each other)"
status = "fail"
effects = "Anyone implementing a parser or validator from this repo will build inconsistent tooling; sibling repos (STATE.a2ml, playbook-a2ml, etc.) that reference META.a2ml for cross-format integration will disagree on shape."

[[must]]
id = "M3"
text = "Example files in examples/ MUST validate against spec/schema/meta.schema.json."
system = "none (no test/script/CI job runs schema validation of examples/*.a2ml or their JSON-binding equivalent against spec/schema/meta.schema.json)"
status = "fail"
effects = "Downstream tooling that trusts 'validate with JSON Schema' (per README) has no evidence the schema and examples are even mutually consistent; risk of silently broken schema."

[[must]]
id = "M4"
text = "The repository MUST carry an unambiguous, machine-checkable license declaration (SPDX identifiers plus a LICENSE file) consistent across README, spec docs, and example files."
system = "none — manual legal/governance judgement always applies to licensing correctness"
status = "manual-only"
effects = "Legal risk for any consumer redistributing or embedding this spec; inconsistent license claims (README says PMPL-1.0 for repo, spec/README.adoc says MIT for spec docs, spec/META-FORMAT-SPEC.adoc says MIT, examples use SPDX MPL-2.0) create ambiguity for downstream compliance tooling."

[[must]]
id = "M5"
text = "CI MUST run an automated check (lint/validate) on every push/PR that exercises the actual META.a2ml format artifacts in this repo (grammar, schema, examples) rather than only generic repo-wide governance/security scans."
system = "none — .github/workflows/*.yml present (codeql.yml, hypatia-scan.yml, secret-scanner.yml, scorecard.yml, governance.yml, mirror.yml, casket-pages.yml, instant-sync.yml) are all generic security/governance/publishing workflows; none parses or validates .a2ml files, the ABNF grammar, or the JSON Schema"
status = "fail"
effects = "Format regressions (like the current README/schema/ABNF/example mismatch) are not caught by CI and will silently ship to consumers of the spec."

[[should]]
id = "S1"
text = "The repository SHOULD provide a reference parser or validator implementation (or bindings) for META.a2ml files."
system = "none — no bindings/, parser/, or scripts/ directory exists in the repo"
status = "fail"
effects = "Every consumer must write its own parser from prose/ABNF alone, increasing risk of divergent implementations."

[[should]]
id = "S2"
text = "The repository SHOULD keep the ABNF grammar synchronized with the current A2ML/TOML-like syntax rather than the legacy Guile Scheme S-expression syntax."
system = "none"
status = "fail"
effects = "spec/abnf/meta.abnf still defines 'define-module' S-expression grammar (Scheme), while .claude/CLAUDE.md states the format 'migrated from Guile Scheme on 2026-04-12' to A2ML/TOML-like syntax and examples/*.a2ml use TOML-like [section] syntax; a grammar-driven validator built from the ABNF would reject every current example."

[[should]]
id = "S3"
text = "The repository SHOULD provide a CONTRIBUTING.md as referenced from README.adoc."
system = "none"
status = "fail"
effects = "README.adoc links to link:CONTRIBUTING.md[CONTRIBUTING.md] which does not exist on disk, giving contributors a broken link and no documented contribution process."

[[should]]
id = "S4"
text = "The repository SHOULD have automated dependency/version currency checks for its CI Action pins."
system = ".github/dependabot.yml (github-actions ecosystem, daily schedule, grouped 'actions' updates)"
status = "pass"
evidence = "/home/user/standards/meta-a2ml/.github/dependabot.yml configures package-ecosystem: github-actions with daily interval and grouped patterns."
check = "test -f meta-a2ml/.github/dependabot.yml && grep -q 'github-actions' meta-a2ml/.github/dependabot.yml"
effects = "Without this, stale/vulnerable pinned Action SHAs would go unnoticed by downstream users of these workflows."

[[could]]
id = "C1"
text = "The project COULD ship a VS Code extension, CLI linter, and documentation generator as described in README's 'Tooling (Planned)' section."
system = "none — explicitly listed as 'Planned' in README.adoc, aspirational reach goal"
status = "aspirational"
effects = "No current impact; purely a future-tooling ambition, not a present gap for any consumer."

[[could]]
id = "C2"
text = "The project COULD achieve formal IETF RFC / IANA media-type registration for META.a2ml as outlined in STANDARDS-TRACK.adoc and UNIFIED-STANDARDS-STRATEGY.adoc."
system = "none — external standards-body process, aspirational by nature"
status = "aspirational"
effects = "No present impact on consumers; only affects long-term interoperability/legitimacy claims once/if registration occurs."

[[could]]
id = "C3"
text = "The repository COULD publish a GitHub Pages rendering of the spec docs for easier consumption."
system = ".github/workflows/casket-pages.yml (GitHub Pages build workflow triggered on push to main)"
status = "pass"
evidence = "/home/user/standards/meta-a2ml/.github/workflows/casket-pages.yml defines a 'build' job under permissions pages:write, id-token:write, triggered on push to main and workflow_dispatch."
check = "test -f meta-a2ml/.github/workflows/casket-pages.yml && grep -q 'pages: write' meta-a2ml/.github/workflows/casket-pages.yml"
effects = "Improves discoverability/readability of the spec for external readers; absence would only reduce convenience, not correctness."
