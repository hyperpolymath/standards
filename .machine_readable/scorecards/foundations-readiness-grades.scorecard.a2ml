# SPDX-License-Identifier: CC-BY-SA-4.0
# foundations-readiness-grades.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "foundations-readiness-grades"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "The normative FRG spec MUST exist as a versioned .adoc document defining the X..A grade ladder and worst-of-required-element aggregation rule."
system = "none (manual inspection of FOUNDATIONS-READINESS-GRADES.adoc)"
status = "pass"
evidence = "/home/user/standards/foundations-readiness-grades/FOUNDATIONS-READINESS-GRADES.adoc exists, Status: Active v1.0 2026-05-28, defines grades X|F|E|D|C|B|A per README.adoc quick mental model (lines 73-84)."
effects = "Without this document, no downstream language repo has a rubric to author spec/FRG-PROFILE.adoc against, and ARG's 'ARG-A requires FRG >= B' cross-axis coupling would be unenforceable."

[[must]]
id = "M2"
text = "Every file in the FRG directory MUST carry an SPDX-License-Identifier header identifying its licence (CC-BY-SA-4.0 for prose, MPL-2.0 for the machine-readable counterpart)."
system = "scripts/check-licence-consistency.sh (repo-root licence check; not directory-scoped) / manual grep"
status = "manual-only"
effects = "Missing/incorrect SPDX headers create licence-provenance ambiguity for any downstream repo vendoring or quoting FRG text; licence identity determinations are always human judgement calls, not automatable pass/fail."

[[must]]
id = "M3"
text = "A machine-readable counterpart (FOUNDATIONS-READINESS-GRADES.a2ml) MUST exist and stay in normative sync with the prose spec."
system = "none — no schema validator or drift-check script for this a2ml was found under scripts/ or .github/workflows/"
status = "fail"
effects = "Tooling that reads a2ml files (e.g. language-status-tracker.jl mentioned in SELF-ASSESSMENT.adoc's Path forward) cannot be trusted to stay accurate if the .adoc and .a2ml drift silently; no CI catches this today."

[[must]]
id = "M4"
text = "At least one hyperpolymath language repo MUST publish a spec/FRG-PROFILE.adoc (per templates/FRG-PROFILE-TEMPLATE.adoc) and be audited against FRG."
system = "none"
status = "fail"
effects = "SELF-ASSESSMENT.adoc itself records this as '[No]' (Phase 4 not started); ephapax, affinescript, and other candidate languages have no FRG grade, so ARG's ARG-A>=FRG-B coupling and any estate-wide FRG comparison table are currently unpopulated/unusable."

[[must]]
id = "M5"
text = "FRG's registration in the estate's spec registry (REGISTRY.a2ml, driven by scripts/build-registry.sh) MUST be present and consistent so the spec is discoverable by tooling."
system = "scripts/build-registry.sh (registry generation) checked against a REGISTRY.a2ml entry"
status = "pass"
evidence = "scripts/build-registry.sh line 79 lists 'foundations-readiness-grades|readiness|foundations-readiness-grades/|FRG — Foundations Readiness Grades|per-language foundational-maturity profile templates', confirming the spec is wired into the registry generator's source table."
effects = "If missing, build-scorecards.sh would flag foundations-readiness-grades as an orphan/unregistered spec, breaking the registry<->scorecard correspondence check that other specs' compliance dashboards rely on."

[[should]]
id = "S1"
text = "A per-spec scorecard for FRG SHOULD exist under .machine_readable/scorecards/ so it participates in the estate COMPLIANCE-DASHBOARD.md."
system = "scripts/build-scorecards.sh (--check/--strict modes enforce registry<->scorecard correspondence)"
status = "fail"
effects = "Before this scorecard is landed, `bash scripts/build-scorecards.sh --strict` would report foundations-readiness-grades as a registered spec with no scorecard, and the estate compliance dashboard undercounts the readiness-grades family."

[[should]]
id = "S2"
text = "The FRG document set SHOULD self-assess its own internal consistency on a defined cadence and after any change to the directory."
system = "none — SELF-ASSESSMENT.adoc's 'Standing rule' calls for re-running an 'invariant-path doc-claims grounder' but no such script exists in scripts/ or hooks/"
status = "fail"
effects = "Stale self-assessment claims (e.g. file-path references) could silently rot as the directory evolves, undermining the honesty the document explicitly commits to in its own 'Standing rule' section."

[[should]]
id = "S3"
text = "FRG SHOULD extend nextgen-languages/TOOLING-STATUS.adoc and language-status-tracker.jl with an FRG column, per the SELF-ASSESSMENT.adoc Path-forward item 2."
system = "none"
status = "fail"
effects = "Without this, FRG grades are invisible from the estate's single per-language tooling-status view, so downstream consumers must know to check FRG separately rather than seeing it alongside ARG/TRG/CRG/RSR."

[[should]]
id = "S4"
text = "The FRG spec's inherited vocabulary (qualifying-provers list, banned-constructs list) SHOULD stay verbatim-synced with its source of truth in TRG."
system = "none — no automated diff between FOUNDATIONS-READINESS-GRADES.a2ml's inherited-from(\"TRG\") blocks and toolchain-readiness-grades' corresponding lists was found"
status = "fail"
effects = "If TRG's qualifying-provers or banned-constructs list changes and FRG's copy is not updated in lockstep, FRG-graded languages could be judged against a stale prover/construct list, silently diverging from TRG."

[[could]]
id = "C1"
text = "FRG-A calibration (>=3 qualifying provers, 100k differential tests, Echidna CI gate, kernel-soundness upstream contribution within 12 months) COULD be reached by a hyperpolymath language, matching the CompCert/CakeML calibration bar."
system = "echidna-verify.yml (CI workflow exists at repo root for Echidna integration generally) plus manual audit"
status = "aspirational"
effects = "This is an intentionally distant reach target; the README itself states the author expects ~0 languages to reach FRG-A in year one, and treats an easy FRG-A as evidence the bar is miscalibrated."

[[could]]
id = "C2"
text = "A fifth qualifying prover beyond {Idris2, Lean 4, Rocq, Agda} COULD be added to the FRG-A cross-prover requirement if a candidate demonstrates equivalent soundness pedigree."
system = "none"
status = "manual-only"
effects = "This is explicitly an open invitation for external argument/evidence in README.adoc; accepting or rejecting a fifth prover is a governance judgement call with no automatable check."
