# SPDX-License-Identifier: CC-BY-SA-4.0
# adoption-readiness-grades.scorecard.a2ml
# Hand-authored source. Regenerate the dashboard with: just scorecards
# Schema: .machine_readable/scorecards/scorecard.schema.json

[scorecard]
spec_id = "adoption-readiness-grades"
version = "1.0.0"
assessed_date = "2026-07-03"
assessor = "estate-audit"

[[must]]
id = "M1"
text = "The ARG normative spec MUST exist as an AsciiDoc document with SPDX headers."
system = "none (manual inspection)"
status = "pass"
evidence = "/home/user/standards/adoption-readiness-grades/ADOPTION-READINESS-GRADES.adoc (507 lines, 12 sections + revision history), SPDX-License-Identifier: CC-BY-SA-4.0 header present at line 1."
effects = "If absent, no downstream language repo has a normative baseline to cite in spec/ARG-PROFILE.adoc; per-language profiles would have nothing to tighten against."

[[must]]
id = "M2"
text = "A language MUST record its ARG grade in spec/ARG-PROFILE.adoc, following the template, supported by evidence for that grade and all grades below (spec section 9, item 1-2)."
system = "none - no CI, script, or lint in this repo checks for the existence or content of spec/ARG-PROFILE.adoc in any consuming language repo"
status = "fail"
effects = "Consuming repos (affinescript, ephapax, my-lang, and 14 other unprofiled languages per AUDIT-FINDINGS-2026-05-28.adoc section 4) cannot make a verifiable ARG claim; nextgen-languages/TOOLING-STATUS.adoc ARG column stays at TBD/dash for unprofiled languages."

[[must]]
id = "M3"
text = "The worst-of-any-required-element aggregation rule (no averaging) MUST be respected when computing a language's ARG grade (spec section 5, section 9 item 4)."
system = "none - aggregation is applied manually by whoever authors spec/ARG-PROFILE.adoc; there is no automated grade calculator in this repo"
status = "manual-only"
effects = "Without automation, grade inflation via averaging is possible unless a human reviewer enforces the rule; AUDIT-FINDINGS-2026-05-28.adoc shows this was applied manually for the 2026-05-28 audit cohort."

[[must]]
id = "M4"
text = "Demotion MUST be recorded immediately (no grace period) on loss of any required A-grade evidence, and ARG MUST NOT exceed TRG at any time (spec section 4.8, section 9 item 5 and 7)."
system = "none - no CI hook in this repo, and no verified cross-repo mechanism, enforces the ARG<=TRG invariant or triggers on demotion events"
status = "fail"
effects = "A language repo could silently drift out of the ARG<=TRG invariant with no automated alert; downstream dashboard consumers (nextgen-languages/TOOLING-STATUS.adoc) would show a stale/incorrect grade until manually caught."

[[must]]
id = "M5"
text = "Per-language profiles MUST NOT loosen the ARG baseline; they MAY only tighten it (spec section 1.1, section 7)."
system = "none - no automated diff/lint compares a language's spec/ARG-PROFILE.adoc against the ARG baseline to detect loosening"
status = "manual-only"
effects = "A maintainer could weaken evidence requirements in a per-language profile undetected; currently relies entirely on human review of each profile PR."

[[should]]
id = "S1"
text = "Per-commit attestations SHOULD be emitted to VeriSimDB at ARG grade C and above via VCL-total DECLARE propositions (spec section 7, section 9 item 6)."
system = "none - SELF-ASSESSMENT.adoc explicitly states this is 'aspirational-from-C' because VeriSimDB is only at alpha (v0.1.0) and the per-language ingestion path is not wired; AUDIT-FINDINGS-2026-05-28.adoc Section 3 describes it as a 4-phase plan (Phase A-D), none of which has landed"
status = "fail"
effects = "No language can currently get automated grade-stale drift detection; any ARG-C+ claim is unverifiable against live evidence until VeriSimDB Phase A-D lands (estimated 1-2+ months per AUDIT-FINDINGS Section 3)."

[[should]]
id = "S2"
text = "A machine-readable grade declaration block SHOULD appear in each language's READINESS.md, parsed by `just arg-grade` and `just arg-badge` from rsr-template-repo (spec section 12)."
system = "none - no rsr-template-repo exists on disk anywhere in this workspace (only referenced in docs/proofs/spec-templates/T1-critical/rsr-template-repo.md, a proof-spec placeholder, not an actual justfile with arg-grade/arg-badge recipes)"
status = "fail"
effects = "Languages cannot generate the shields.io ARG badge referenced in templates/ARG-PROFILE-TEMPLATE.adoc footer ('Run just arg-badge'); dashboard/README badges for ARG grade are currently manual or absent."

[[should]]
id = "S3"
text = "The profile SHOULD be reviewed at least once per release cycle, and within 7 days of any demotion event (spec section 9 item 3)."
system = "none - no scheduled CI (cron) or issue-bot exists in this repo to trigger periodic profile review"
status = "fail"
effects = "Profiles can go stale between manual audits (e.g. the single 2026-05-28 audit cohort); no automated staleness reminder exists for affinescript/ephapax/my-lang or any other consuming repo."

[[should]]
id = "S4"
text = "A machine-readable counterpart of the normative spec (.a2ml) SHOULD exist and stay consistent with the .adoc."
system = "none - no script cross-validates ADOPTION-READINESS-GRADES.a2ml against ADOPTION-READINESS-GRADES.adoc for consistency; consistency is asserted only in SELF-ASSESSMENT.adoc's manually-ticked checklist"
status = "pass"
evidence = "/home/user/standards/adoption-readiness-grades/ADOPTION-READINESS-GRADES.a2ml exists (339 lines, SPDX-License-Identifier: MPL-2.0), referenced consistently in README.adoc and SELF-ASSESSMENT.adoc as the machine-readable counterpart."
effects = "If it drifted from the prose spec unnoticed, any tool consuming the a2ml form would diverge from the documented normative rules; currently no automated guard against that drift."

[[could]]
id = "C1"
text = "At least one language COULD be fully audited against ARG with a committed profile, as a proof-of-concept of the framework (SELF-ASSESSMENT.adoc 'Path forward' item 1)."
system = "none - SELF-ASSESSMENT.adoc explicitly marks 'At least one language audited against ARG' as unmet (cross mark) at time of writing; AUDIT-FINDINGS-2026-05-28.adoc records honest draft grades for affinescript/ephapax/my-lang but Section 4 states all 6 profile files (3 ARG + 3 FRG) are 'uncommitted in their respective repos'"
status = "fail"
effects = "The framework has no committed, checkable example for other language maintainers to model their own spec/ARG-PROFILE.adoc on; nextgen-languages dashboard TBD entries stay empty."

[[could]]
id = "C2"
text = "ARG-A COULD eventually be reached by a hyperpolymath language, calibrated against first-generation Python and modern Rust (spec section 11)."
system = "none"
status = "aspirational"
effects = "None currently - this is an explicit reach target; the spec itself states it expects approximately zero languages to hit ARG-A in year one, and treats an early ARG-A claim as evidence the bar is miscalibrated rather than success."

[[could]]
id = "C3"
text = "External review of ARG by language designers outside the hyperpolymath estate COULD occur once the first audit cohort completes (SELF-ASSESSMENT.adoc 'Path forward' item 3)."
system = "none"
status = "aspirational"
effects = "Without external review, ARG's thresholds (1000-user A-gate, 6-diverse-project B-gate, founder bus-factor test) remain single-author calibrations per section 10's own open-questions list."

[[could]]
id = "C4"
text = "An estate-wide CI-hygiene lint COULD be built to prevent soft-fail/xfail anti-patterns from masking prover-CI results across ARG/FRG-adjacent repos (AUDIT-FINDINGS-2026-05-28.adoc section 7.7)."
system = "none - explicitly deferred per AUDIT-FINDINGS section 7.7 ('Defer until separate session')"
status = "fail"
effects = "Individual repos (echo-types, echidna, affinescript) had 3 real soft-fail bugs found and fixed manually in this one sweep; without a standing lint, similar regressions could reappear undetected in any of the ~80 repos with prover CI in scope."
