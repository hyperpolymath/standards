;; Verb registry. Discover verbs here. Do not read INDEX.a2ml.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "contractiles"
  :beholding-chora #u5"estate/chora"
  ;; The live contractile form is the K9 Nickel contract (D173), not A2ML.
  (verb :name adjust :authority advisory :semantics "drift tolerances and corrective actions" :contract ".machine_readable/contractiles/adjust/adjust.k9.ncl" :runner ".machine_readable/contractiles/adjust/adjust.ncl")
  (verb :name bust :authority blocking :semantics "hard-stop, expiry, and must-not-run declarations" :contract ".machine_readable/contractiles/bust/bust.k9.ncl" :runner ".machine_readable/contractiles/bust/bust.ncl")
  (verb :name dust :authority advisory :semantics "rollback, recovery, deprecation, and audit-trail preservation" :contract ".machine_readable/contractiles/dust/dust.k9.ncl" :runner ".machine_readable/contractiles/dust/dust.ncl")
  (verb :name intend :authority reporting :semantics "north-star commitments and aspirations" :contract ".machine_readable/contractiles/intend/intend.k9.ncl" :runner ".machine_readable/contractiles/intend/intend.ncl")
  (verb :name must :authority blocking :semantics "release-blocking invariants" :contract ".machine_readable/contractiles/must/must.k9.ncl" :runner ".machine_readable/contractiles/must/must.ncl")
  (verb :name trust :authority blocking :semantics "trust boundary and integrity checks" :contract ".machine_readable/contractiles/trust/trust.k9.ncl" :runner ".machine_readable/contractiles/trust/trust.ncl")
)
