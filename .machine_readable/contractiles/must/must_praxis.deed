;; Live Mustfile. Checks are clauses; the runner reads :body.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "must"
  :beholding-chora #u5"estate/chora"
  ;; Translated from the archived Mustfile.a2ml. The archive copy is unchanged.
  (check :id license-present :severity critical :discharge run :description "LICENSE file must exist" :body "test -f LICENSE")
  (check :id licence-policy-present :severity critical :discharge run :description "3-practice/LICENCE-POLICY.adoc (canonical licence policy) must exist" :body "test -f 3-practice/LICENCE-POLICY.adoc")
  (check :id readme-present :severity critical :discharge run :description "README.adoc must exist" :body "test -f README.adoc")
  (check :id security-policy :severity critical :discharge run :description "3-practice/SECURITY.adoc must exist" :body "test -f 3-practice/SECURITY.adoc")
  (check :id ai-manifest :severity critical :discharge run :description "0-AI-MANIFEST.deed must exist under descriptiles" :body "test -f .machine_readable/descriptiles/0-AI-MANIFEST.deed")
  (check :id machine-readable-dir :severity critical :discharge run :description ".machine_readable/ directory must exist" :body "test -d .machine_readable")
  (check :id licensing-policy-machine-readable :severity critical :discharge run :description "machine-readable licensing policy must exist" :body "test -f .machine_readable/licensing-policy.toml")
  (check :id code-spdx-mpl :severity critical :discharge run :description "code/config/scripts carry SPDX-License-Identifier MPL-2.0" :body "head -8 Justfile | grep -q 'SPDX-License-Identifier: MPL-2.0'")
  (check :id docs-spdx-ccbysa :severity critical :discharge run :description "prose docs carry SPDX-License-Identifier CC-BY-SA-4.0" :body "head -8 README.adoc | grep -q 'SPDX-License-Identifier: CC-BY-SA-4.0'")
  (check :id licenses-texts-present :severity critical :discharge run :description "LICENSES/ carries the canonical text for every SPDX id in use" :body "test -f LICENSES/MPL-2.0.txt && test -f LICENSES/CC-BY-SA-4.0.txt")
  (check :id no-pmpl-outside-carveout :severity critical :discharge run :description "PMPL appears in no standards-authored header (carve-out = 3 repos only)" :body "test -z \"$(git ls-files ':!:consent-aware-http/**' ':!:*palimpsest*' ':!:LICENSES/**' | while read -r f; do head -8 \"$f\" 2>/dev/null | grep -qm1 'SPDX-License-Identifier: PMPL' && echo \"$f\"; done)\"")
  (check :id policy-no-contradiction :severity critical :discharge run :description "3-practice/LICENCE-POLICY.adoc and licensing-policy.toml agree (both name CC-BY-SA-4.0)" :body "grep -q 'CC-BY-SA-4.0' 3-practice/LICENCE-POLICY.adoc && grep -q 'CC-BY-SA-4.0' .machine_readable/licensing-policy.toml")
  (check :id no-loose-contractile-in-root :severity low :discharge run :description "no .contractile files loose in repo root — they live in .machine_readable/" :body "test -z \"$(ls *.contractile 2>/dev/null)\"")
  (check :id actions-sha-pinned :severity critical :discharge run :description "every GitHub Action is pinned to a 40-char commit SHA" :body "! grep -rEn 'uses:[[:space:]]+\"?[^@\"]+@(v?[0-9.]+|main|master)\"?,?([[:space:]]|$)' .github/workflows/ 2>/dev/null")
  (check :id jobs-have-timeout :severity high :discharge verification :description "every non-reusable-caller job declares timeout-minutes" :body "governance check — reusable-workflow caller jobs (uses: ./...) are exempt")
)
