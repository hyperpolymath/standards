//
// Result type for proven bindings. AffineScript port of ProvenResult.res.
// Matches the JS { ok: boolean, value?: T, error?: string } pattern.

module ProvenResult;

pub type JsResult<v> = {
  ok: Bool,
  value: Option<v>,
  error: Option<String>,
}

extern fn ok_js(value: v) -> JsResult<v> = "proven/result" "ok";
extern fn err_js(error: String) -> JsResult<v> = "proven/result" "err";

// Convert a JS result to an AffineScript Result.
pub fn from_js(js: JsResult<v>) -> Result<v, String> {
  if js.ok {
    match js.value {
      Some(v) => Ok(v),
      None    => Err("Ok result missing value"),
    }
  } else {
    match js.error {
      Some(e) => Err(e),
      None    => Err("Unknown error"),
    }
  }
}

// Convert an AffineScript Result to a JS result.
pub fn to_js(r: Result<v, String>) -> JsResult<v> {
  match r {
    Ok(value)  => JsResult { ok: true,  value: Some(value), error: None },
    Err(error) => JsResult { ok: false, value: None,        error: Some(error) },
  }
}
