;; ECOSYSTEM.a2ml - Ecosystem position for playbook-a2ml
;; Media-Type: application/vnd.ecosystem+scm

(ecosystem
  (version "1.0")
  (name "playbook-a2ml")
  (type "specification")
  (purpose "Define executable plan format for .scm Format Family")

  (position-in-ecosystem
    (category "standards")
    (subcategory "scm-format-family")
    (tier "execution")
    (unique-value
      ("Derived authority from META"
       "Gated execution through AGENTIC"
       "Machine-readable runbooks")))

  (related-projects
    ((name "standards")
     (relationship "parent")
     (url "https://github.com/hyperpolymath/standards"))
    ((name "meta-a2ml")
     (relationship "constitutional-authority")
     (url "https://github.com/hyperpolymath/standards/tree/main/meta-a2ml"))
    ((name "agentic-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/agentic-a2ml"))
    ((name "neurosym-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/neurosym-a2ml"))
    ((name "anchor-a2ml")
     (relationship "intervention-layer")
     (url "https://github.com/hyperpolymath/standards/tree/main/anchor-a2ml")))

  (what-this-is
    ("Executable plan specification"
     "Operational runbook format"
     "Machine-readable deployment procedures"
     "Failure handling and rollback definitions"))

  (what-this-is-not
    ("Constitutional authority (that's META)"
     "Operational gating (that's AGENTIC)"
     "Symbolic semantics (that's NEUROSYM)"
     "Implementation code")))
