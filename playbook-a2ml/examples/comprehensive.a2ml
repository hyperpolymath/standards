#
# PLAYBOOK.a2ml — Comprehensive Example with All Sections
# enterprise-platform
#
# Full-featured PLAYBOOK demonstrating all sections and capabilities.
# This is the current (A2ML) format. Supersedes comprehensive.scm.

[metadata]
version = "1.0.0"
last-updated = "2026-04-12"

# ==============================================================
# DERIVATION SOURCE
# ==============================================================
# Documents the authority chain for this PLAYBOOK

[derivation-source]
type = "derived"
meta-rules = ["ADR-001", "ADR-005", "ADR-012", "ADR-015"]
state-context = "beta-phase"
agentic-gate = "entropy-budget-ok"
timestamp = "2026-04-12T00:00:00Z"
validated-by = "pre-deploy-checklist"

# ==============================================================
# PROCEDURES
# ==============================================================

[procedures.build]
description = "Build all project artifacts"
preconditions = ["src/ directory exists", "dependencies installed", "no uncommitted changes"]

[[procedures.build.steps]]
step = 1
name = "clean"
action = "just clean"
timeout = 60
can-fail = true

[[procedures.build.steps]]
step = 2
name = "compile"
action = "just build"
timeout = 300
can-fail = false

[[procedures.build.steps]]
step = 3
name = "test"
action = "just test"
timeout = 600
can-fail = false

[procedures.deploy]
description = "Deploy to production environment"
preconditions = [
  "build procedure completed",
  "all tests passed",
  "panic-attack assail clean",
  "OpenSSF Scorecard >= 9.0",
]

[[procedures.deploy.steps]]
step = 1
name = "preflight"
action = "just release-preflight"
timeout = 120
can-fail = false

[[procedures.deploy.steps]]
step = 2
name = "container-push"
action = "just container-push"
timeout = 180
can-fail = false

[[procedures.deploy.steps]]
step = 3
name = "verify"
action = "just health-check"
timeout = 60
can-fail = false

[procedures.rollback]
description = "Rollback to the previous stable version"
preconditions = ["previous container image tag known"]

[[procedures.rollback.steps]]
step = 1
name = "identify-previous"
action = "just rollback-identify"
timeout = 30
can-fail = false

[[procedures.rollback.steps]]
step = 2
name = "deploy-previous"
action = "just rollback-deploy"
timeout = 180
can-fail = false

# ==============================================================
# RELEASE PROCESS
# ==============================================================

[release-process]
steps = [
  "Update version in .machine_readable/6a2/STATE.a2ml, META.a2ml, justfile",
  "Run `just release-preflight` (validate + quality + security + maint-hard-pass)",
  "Tag and push: `git tag vX.Y.Z && git push origin main --tags`",
  "Run `just container-push` to publish container image",
]

# ==============================================================
# INCIDENT RESPONSE
# ==============================================================

[incident-response.severity-levels]
P0 = "Production outage — page on-call immediately"
P1 = "Degraded production — respond within 1 hour"
P2 = "Non-production impact — respond within 1 business day"
P3 = "Minor / cosmetic — respond within 1 week"

[incident-response.initial-triage]
steps = [
  "Check .machine_readable/6a2/STATE.a2ml for current project status",
  "Review recent commits and CI results on GitHub",
  "Run `just validate` to check RSR compliance",
  "Run `just security` to audit for vulnerabilities",
  "Check Hypatia scan results for new failures",
]

[incident-response.escalation]
P0-contact = "page-on-call"
P1-contact = "team-chat"
external-security = "security@example.com"

# ==============================================================
# MAINTENANCE OPERATIONS
# ==============================================================

[maintenance-operations]
baseline-audit = "just maint-audit"
hard-release-gate = "just maint-hard-pass"
permission-audit = "just perms-audit"
security-scan = "panic-attack assail ."
dependency-update = "just deps-update"

# ==============================================================
# ALERTS
# ==============================================================

[[alerts]]
name = "panic-attack-critical"
condition = "panic-attack assail exits with critical findings"
severity = "P1"
action = "Block all commits; notify team"

[[alerts]]
name = "scorecard-regression"
condition = "OpenSSF Scorecard drops below 9.0"
severity = "P2"
action = "Investigate and remediate within 1 business day"

[[alerts]]
name = "hypatia-new-failure"
condition = "Hypatia rule failure count increases"
severity = "P2"
action = "Classify each new failure against testing taxonomy"
