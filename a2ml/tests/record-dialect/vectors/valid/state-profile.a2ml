# Declares the a2ml/state profile and carries its three required sections
# (metadata, position, maintenance-status) — MUST validate at R1 (spec 10, 9.5).
@profile(id=a2ml/state)

[metadata]
project = "example"
version = "1.0.0"
last-updated = "2026-07-03"

[position]
phase = "maintenance"
maturity = "production"

[maintenance-status]
last-run-utc = "2026-07-03T00:00:00Z"
last-result = "pass"
