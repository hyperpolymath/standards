-- SPDX-License-Identifier: MPL-2.0
-- a2ml-core.ipkg — the NORMATIVE A2ML typed core.
--
-- SPEC.adoc §3.1: "The normative Idris2 model lives in `src/A2ML/` … the
-- source files are authoritative." This package is the INTENDED machine check
-- for that claim.
--
-- ⚠ IT DOES NOT PASS YET, and nothing runs it.
--   `idris2 --typecheck a2ml-core.ipkg` exits 1 with 14 errors, all in
--   A2ML.Parser (measured 2026-07-29, Idris2 0.7.0):
--     7 × totality      — %default total vs genuinely recursive parser functions
--     5 × unification   — `Maybe Char` supplied where `()` is expected
--     1 × undefined     — the `<|>` alternative operator is never defined
--     1 × visibility    — A2ML.TypedCore.collectIds is private but used here
--   and NO workflow in this repository invokes it, so the claim above is not
--   currently machine-checked by anything.
--
-- The comment previously asserted that this "type-checks every module in the
-- core". That was false. It is stated honestly here rather than quietly
-- narrowed, because a claim of verification that nothing verifies is exactly
-- the fake gate the next paragraph warns about.
--
-- Use the ipkg target, never per-file `idris2 --check`: a per-file check
-- exits 0 when an imported module is simply missing, which makes it a fake
-- gate (estate-wide lesson; see the CI job that consumes this).

package a2ml-core

authors    = "Jonathan D.A. Jewell (hyperpolymath)"
license    = "MPL-2.0"
sourcedir  = "src"

modules = A2ML.TypedCore
        , A2ML.Surface
        , A2ML.Parser
        , A2ML.Translator
        , A2ML.Converters
        , A2ML.BaseVocab
        , A2ML.Profiles
        , A2ML.Proofs
        , A2ML.CoreTests
        , A2ML.ParserTests
        , A2ML.Tests
