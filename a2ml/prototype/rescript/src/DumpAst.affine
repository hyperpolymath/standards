// AffineScript port of DumpAst.res.

module DumpAst;

use Compat;
use A2ml;
use Json;

extern fn read_file_sync(path: String, enc: String) -> String = "fs" "readFileSync";
extern fn argv() -> [String] = "process" "argv";

pub fn main() -> Effect[IO] Unit {
  let args = argv();
  if len(args) < 3 {
    Compat.console_log("Usage: dump-ast <path>")
  } else {
    let input = read_file_sync(args[2], "utf8");
    let doc = A2ml.parse(A2ml.Lax, input);
    Compat.console_log(Json.doc_to_json(doc))
  }
}

main()
