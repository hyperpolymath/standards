// AffineScript port of Demo.res.

module Demo;

use A2ml;

extern fn console_log(v: a) -> Unit = "console" "log";

pub let demo_doc = "# A2ML Overview\n\n@abstract:\nA2ML is a typed, attested markup format.\n@end\n\n## Claims\n- Required sections must exist.\n- References must resolve.\n";

pub fn main() -> Effect[IO] Unit {
  let parsed = A2ml.parse(A2ml.Lax, demo_doc);
  let html = A2ml.render_html(parsed);
  let errors = A2ml.validate_checked(parsed);
  // Replace with DOM updates in a real web integration.
  console_log(html);
  console_log(errors)
}

main()
