module WasmDemo;

// SPDX-License-Identifier: PMPL-1.0-or-later

// A2ML WASM protostruct using rescript-wasm-runtime.
// This is a minimal demo intended for local testing only.

// Assumes rescript-wasm-runtime is available locally.
// You can add it to a workspace or compile this in a repo where
// rescript-wasm-runtime's compiled JS is on the module path.

fn buildWasm = async () => {
  fn ok = await Wasm.compileToWasm("fixtures/add.wat", "build/add.wasm", ())
  if !ok {
    Js.log("WASM compile failed")
  }
}

fn runWasm = async () => {
  fn instance = await Wasm.loadModule("build/add.wasm", ())
  fn exports: Js.t<{. add: (int, int) => int}> = %raw(`instance.exports`)
  fn result = exports##add(2, 3)
  Js.log(`add(2,3) = ${Int.toString(result)}`)
}

fn _ = {
  fn _ = buildWasm()
  fn _ = runWasm()
}

