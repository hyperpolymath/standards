#
# NEUROSYM.a2ml — Comprehensive Example with All Sections
# enterprise-platform
#
# Full-featured NEUROSYM demonstrating all sections and capabilities.
# This is the current (A2ML) format. Supersedes comprehensive.scm.

[metadata]
version = "1.0.0"
last-updated = "2026-04-12"

# ==============================================================
# HYPATIA CONFIGURATION
# ==============================================================

[hypatia-config]
scan-enabled = true
scan-depth = "deep"         # quick | standard | deep
report-format = "assail"    # assail = JSON AssailReport consumed by Hypatia Elixir rules
scan-on-commit = true

# ==============================================================
# SYMBOLIC RULES
# ==============================================================
# Custom project-level rules for Hypatia symbolic scanning

[[symbolic-rules]]
name = "no-unsafe-ffi"
pattern = "believe_me|unsafeCoerce|Obj\\.magic|getUnsafe|getExn"
severity = "critical"
category = "unsafe_blocks"
description = "Banned partial cast / unsafe bypass patterns"

[[symbolic-rules]]
name = "no-admitted-proofs"
pattern = "Admitted|sorry"
severity = "critical"
category = "proof_holes"
description = "Incomplete formal proofs"

[[symbolic-rules]]
name = "no-banned-languages"
pattern = "\\.ts$|\\.tsx$|\\.py$|\\.go$"
severity = "high"
category = "language_policy"
description = "Banned language file extensions"

[[symbolic-rules]]
name = "spdx-required"
pattern = "^(?!.*SPDX-License-Identifier)"
severity = "medium"
category = "license_compliance"
description = "SPDX header missing"

# ==============================================================
# OPERATION DEFINITIONS
# ==============================================================
# Semantic meaning of each reversible operation

[[operation-definitions]]
name = "file-read"
forward-semantics = "Return file contents as byte sequence"
inverse = false
claim-type = "verified"
entropy-contribution = 1
preconditions = ["file-exists", "read-permission"]
postconditions = ["content-unchanged"]
idempotent = true

[[operation-definitions]]
name = "file-write"
forward-semantics = "Replace file contents with new byte sequence"
inverse = "file-write-with-original"
claim-type = "compensable"
entropy-contribution = 5
preconditions = ["write-permission", "valid-content", "sufficient-space"]
postconditions = ["content-matches-input", "metadata-updated"]
idempotent = false

[[operation-definitions]]
name = "file-delete"
forward-semantics = "Remove file from filesystem permanently"
inverse = false
claim-type = "irreversible"
entropy-contribution = 20
preconditions = ["delete-permission", "file-exists", "not-open"]
postconditions = ["file-not-exists"]
idempotent = true

[[operation-definitions]]
name = "git-commit"
forward-semantics = "Create a new commit on the current branch"
inverse = "git-revert"
claim-type = "compensable"
entropy-contribution = 10
preconditions = ["panic-attack-assail-pass", "staged-changes-present"]
postconditions = ["commit-hash-stable", "history-preserved"]
idempotent = false

# ==============================================================
# COMPOSITION RULES
# ==============================================================
# Rules for safe operation composition

[composition-rules]
max-sequential-irreversible = 1
require-confirmation-before = ["file-delete", "git-push", "infrastructure-change"]
always-log = true

# ==============================================================
# PROOF OBLIGATIONS
# ==============================================================
# Formal properties that must hold

[[proof-obligations]]
name = "no-phantom-entropy"
statement = "Sum of operation entropy contributions must not exceed session budget"
verifier = "hypatia"

[[proof-obligations]]
name = "compensation-complete"
statement = "All compensable operations must have reachable compensation paths"
verifier = "idris2"

# ==============================================================
# NEURAL CONFIGURATION
# ==============================================================

[neural-config]
confidence-threshold = 0.85
model = "hypatia-v2"
anomaly-detection = true
pattern-learning = false   # Disabled in production; enable only in research mode
