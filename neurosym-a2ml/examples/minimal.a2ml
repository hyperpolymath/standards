#
# NEUROSYM.a2ml — Minimal Example
# minimal-project
#
# This is the current (A2ML) format. Supersedes minimal.scm.

[metadata]
version = "0.1.0"
last-updated = "2026-04-12"

[hypatia-config]
scan-enabled = true
scan-depth = "standard"
report-format = "assail"

[[operation-definitions]]
name = "file-read"
forward-semantics = "Return file contents"
inverse = false
claim-type = "verified"
entropy-contribution = 1
