;; ECOSYSTEM.a2ml - Ecosystem position for neurosym-a2ml
;; Media-Type: application/vnd.ecosystem+a2ml

(ecosystem
  (version "1.0")
  (name "neurosym-a2ml")
  (type "specification")
  (purpose "Define symbolic semantics and proof obligations")

  (position-in-ecosystem
    (category "standards")
    (subcategory "scm-format-family")
    (tier "execution")
    (unique-value
      ("Symbolic semantics definitions"
       "Composition rule algebra"
       "Proof obligation interfaces"
       "Type system specifications")))

  (related-projects
    ((name "standards")
     (relationship "parent")
     (url "https://github.com/hyperpolymath/standards"))
    ((name "meta-a2ml")
     (relationship "constitutional-authority")
     (url "https://github.com/hyperpolymath/standards/tree/main/meta-a2ml"))
    ((name "playbook-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/playbook-a2ml"))
    ((name "agentic-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/agentic-a2ml"))
    ((name "anchor-a2ml")
     (relationship "intervention-layer")
     (url "https://github.com/hyperpolymath/standards/tree/main/anchor-a2ml")))

  (what-this-is
    ("Symbolic semantics specification"
     "Operation meaning definitions"
     "Composition rule algebra"
     "Proof obligation interfaces"
     "Type system for operations"))

  (what-this-is-not
    ("Constitutional authority (that's META)"
     "Operational gating (that's AGENTIC)"
     "Executable plans (that's PLAYBOOK)"
     "Implementation code")))
