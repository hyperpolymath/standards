# UX Test Harness: Alpine — tests repo setup on minimal musl-libc system
FROM docker.io/library/alpine:3.21

RUN apk add --no-cache \
    git bash curl unzip tar gzip xz \
    gcc g++ musl-dev make cmake pkgconf \
    openssl-dev zlib-dev \
    just

RUN adduser -D testuser
USER testuser
WORKDIR /home/testuser

VOLUME /repo

COPY --chown=testuser:testuser run-ux-test.sh /home/testuser/run-ux-test.sh
RUN chmod +x /home/testuser/run-ux-test.sh

ENTRYPOINT ["/home/testuser/run-ux-test.sh"]
