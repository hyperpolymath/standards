; SPDX-License-Identifier: MPL-2.0
; HYP-UUID-001 — estate UUID policy enforcement (ADR-008, amended by D320).
; Supersedes uuid-v7-estate-conformance.a2ml: the estate standardised on v7
; (#1063) and was amended to strict UUIDv8 profile C by owner ruling D320
; (2026-10-07). The gates run strict, version 8 only.

(rule
  (id "HYP-UUID-001")
  (name "Estate UUIDs are version 8, profile C, over registered domains")
  (severity high)
  (category identity-integrity)
  (source "docs/decisions/ADR-008-uuid-v8-estate-standard.adoc (amendment D320)")
  (applies-to ("hyperpolymath" "metadatastician"))
  (must
    "all newly generated UUIDs are UUIDv8 profile C: bytes 0..15 of SHA-256(domain \":\" name), version nibble 8, RFC 9562 variant 10"
    "the domain is registered in docs/decisions/ADR-008-profile-c-domains.json and the preimage identifies the artifact itself, never another repository"
    "all UUID literals have version nibble 8 and RFC 9562 variant 10; v5 and v7 literals are rejected by the strict gate"
    "a Julia [deps] mapping that names an estate package uses that package's own declared uuid, so every Project.toml in the repo is self-consistent"
    "legacy values have an auditable migration alias and explicit type"
    "unknown and unmeasured repositories are not reported as compliant")
  (gate "scripts/check-uuid-v8.sh")
  (remediation "re-mint from the registered domain and the artifact's own preimage; never hash-copy legacy UUIDs and never retain a preimage that identifies a different repository"))
