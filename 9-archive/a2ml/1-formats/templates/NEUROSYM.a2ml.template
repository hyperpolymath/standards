# SPDX-License-Identifier: MPL-2.0
# NEUROSYM.a2ml - Neurosymbolic integration config
# Template from: https://github.com/hyperpolymath/standards
#
# HUMAN SUMMARY: This file configures the neurosymbolic layer — the bridge
# between symbolic reasoning (formal logic, proofs, type systems) and neural
# reasoning (LLMs, embeddings). Most projects only use the symbolic layer.
# Only enable the neural layer if this project does ML/AI inference work.

# ── Neurosymbolic Configuration ───────────────────────────────────────────
[neurosym-config]
# version: Format version for this file.
version = "1.0.0"

# project: Must match the repo name exactly.
project = "{{PROJECT_NAME}}"

# ── Symbolic Layer ─────────────────────────────────────────────────────────
[neurosym-config.symbolic-layer]
# type: What format are the symbolic definitions in?
#   a2ml    — A2ML metadata files (most common)
#   idris2  — Idris2 formal proofs
#   lean    — Lean4 formal proofs
type = "a2ml"

# reasoning: What kind of symbolic reasoning is used?
#   deductive  — from general rules to specific conclusions
#   inductive  — from specific examples to general rules
#   abductive  — inference to the best explanation
reasoning = "deductive"

# verification: How are symbolic claims verified?
#   formal     — machine-checked proofs (Idris2, Lean)
#   tested     — property-based tests as proxy for proofs
#   manual     — human review only
verification = "formal"

# ── Language-Specific Symbolic Config ─────────────────────────────────────
[neurosym-config.symbolic-layer.language-specific]
# Add language-specific symbolic reasoning config here.
# Example for a language project:
#   grammar-verified = true
#   type-system-proven = false

# ── Neural Layer ──────────────────────────────────────────────────────────
[neurosym-config.neural-layer]
# embeddings: Does this project use vector embeddings?
embeddings = false

# fine-tuning: Does this project fine-tune models?
fine-tuning = false

# inference: Does this project run neural inference?
inference = false

# ── Integration ───────────────────────────────────────────────────────────
[neurosym-config.integration]
# How symbolic and neural layers interact. Leave empty if only using
# one layer. Example entries:
#   mode = "symbolic-guides-neural"  — proofs constrain LLM output
#   mode = "neural-suggests-symbolic" — LLM proposes, prover verifies

# ── Provenance ─────────────────────────────────────────────────────────────
[provenance]
# Audit trail — updated automatically by agents/bots on every write.
# Humans: you can ignore this section, but don't delete it.
last-modified-by = "{{AGENT_ID}}"
last-modified-at = "{{TIMESTAMP}}"
last-session-id = ""
git-sha-at-read = ""
modification-summary = "Initial creation from template"
