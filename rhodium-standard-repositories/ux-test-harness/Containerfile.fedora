# UX Test Harness: Fedora — tests repo setup on a clean Fedora system
FROM registry.fedoraproject.org/fedora:43

RUN dnf install -y --setopt=install_weak_deps=False \
    git just curl unzip tar gzip xz \
    gcc gcc-c++ make cmake pkg-config \
    openssl-devel zlib-devel \
    && dnf clean all

# Create non-root user (typical user install scenario)
RUN useradd -m testuser
USER testuser
WORKDIR /home/testuser

# The repo will be mounted at /repo
VOLUME /repo

COPY --chown=testuser:testuser run-ux-test.sh /home/testuser/run-ux-test.sh
RUN chmod +x /home/testuser/run-ux-test.sh

ENTRYPOINT ["/home/testuser/run-ux-test.sh"]
