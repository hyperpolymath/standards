# UX Test Harness: Ubuntu — tests repo setup on a clean Ubuntu system
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip tar gzip xz-utils ca-certificates \
    gcc g++ make cmake pkg-config \
    libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install just
RUN curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

RUN useradd -m testuser
USER testuser
WORKDIR /home/testuser

VOLUME /repo

COPY --chown=testuser:testuser run-ux-test.sh /home/testuser/run-ux-test.sh
RUN chmod +x /home/testuser/run-ux-test.sh

ENTRYPOINT ["/home/testuser/run-ux-test.sh"]
