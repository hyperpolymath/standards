#
# META.a2ml — Comprehensive Example with All Sections
# enterprise-platform
#
# This is the current (A2ML) format for META checkpoint files.
# The legacy Guile Scheme (.scm) format is deprecated; see comprehensive.scm for reference.

[metadata]
version = "1.0.0"
last-updated = "2026-04-12"

[project-info]
name = "enterprise-platform"
type = "service"
languages = ["rust", "rescript", "elixir"]
license = "PMPL-1.0-or-later"
author = "Jonathan D.A. Jewell"

# ==============================================================
# ARCHITECTURE DECISIONS (ADRs)
# ==============================================================
# Status values: proposed | accepted | deprecated | superseded | rejected

[[architecture-decisions]]
id = "ADR-001"
title = "Microservices Architecture"
status = "accepted"
date = "2025-01-15"
context = "System requires independent scaling of components and team autonomy for parallel development"
decision = "Adopt microservices architecture with domain-driven service boundaries"
consequences = [
  "Independent deployment of services",
  "Technology diversity per service",
  "Increased operational complexity",
  "Requires robust service discovery",
]
deciders = ["Alice Chen", "Bob Kumar", "Carol Martinez"]
references = ["https://martinfowler.com/microservices/"]

[[architecture-decisions]]
id = "ADR-002"
title = "Event-Driven Communication"
status = "accepted"
date = "2025-01-20"
context = "Services need loose coupling for resilience and to handle varying load patterns"
decision = "Use Apache Kafka for async communication between services; gRPC for synchronous calls where latency is critical"
consequences = [
  "Eventual consistency model",
  "Kafka operational expertise required",
  "Clear synchronous vs async boundaries",
  "Audit trail via event log",
]

[[architecture-decisions]]
id = "ADR-003"
title = "VeriSimDB as Primary Database"
status = "accepted"
date = "2025-02-01"
context = "Need database with strong consistency, formal verification properties, and proven reliability"
decision = "Use VeriSimDB for all services unless specific requirements dictate otherwise"
consequences = [
  "Consistent database expertise",
  "Formally verified query semantics",
  "Well-understood backup and HA patterns",
]

[[architecture-decisions]]
id = "ADR-004"
title = "Stapeln for Container Orchestration"
status = "accepted"
date = "2025-02-10"
context = "Need container orchestration for microservices deployment with supply-chain security"
decision = "Use Stapeln with Chainguard base images and Podman rootless containers"
consequences = [
  "Standardised deployment across environments",
  "Minimal attack surface via Chainguard Wolfi",
  "No privileged daemon (Podman rootless)",
  "Requires dedicated platform engineering",
]

[[architecture-decisions]]
id = "ADR-005"
title = "Polyrepo Over Monorepo"
status = "rejected"
date = "2025-02-15"
context = "Team debated repository strategy for microservices"
decision = "Rejected monorepo in favour of polyrepo with service ownership model"
consequences = [
  "Clearer ownership boundaries",
  "Simpler CI/CD per service",
  "Challenge: shared library versioning",
  "Requires good documentation practices",
]

[[architecture-decisions]]
id = "ADR-006"
title = "API Gateway Pattern"
status = "proposed"
date = "2025-03-01"
context = "Need unified entry point for external API consumers"
decision = "Implement an API gateway with rate limiting, authentication, and request transformation"
consequences = [
  "Single entry point for clients",
  "Centralised cross-cutting concerns",
  "Potential single point of failure",
  "Additional infrastructure component",
]

# ==============================================================
# DEVELOPMENT PRACTICES
# ==============================================================

[development-practices]
build-tool = "just"
container-runtime = "podman"
ci-platform = "github-actions"
package-manager = "guix"

[development-practices.code-style]
formatter = "rustfmt for Rust, rescript-format for ReScript"
linter = "clippy, rescript-linter"
line-length = 100
indent = "spaces"
indent-size = 2

[development-practices.security]
command-execution = "no shell injection; use structured args"
credentials = "never in code; use environment-bound secrets"
dependencies = "SHA-pinned in CI; SPDX headers on all files"
authentication = "OAuth 2.0 + OIDC"

[development-practices.documentation]
format = "AsciiDoc for long-form; Markdown for GitHub-required files (SECURITY.md, CONTRIBUTING.md)"
adr-location = "META.a2ml in each service repository"
runbooks = "Required for all production services"
diagrams = "Mermaid, version controlled"

[development-practices.testing]
coverage-minimum = 80
unit-tests = "Required for all business logic"
integration-tests = "Required for all API endpoints"
e2e-tests = "Critical user journeys only"

[development-practices.versioning]
scheme = "Semantic Versioning 2.0.0"
changelog = "Keep a Changelog format"
breaking-changes = "Announce 2 weeks in advance"

[development-practices.review]
required-approvals = 2
automated-checks = ["lint", "test", "security-scan", "type-check"]
sla = "Review within 24 business hours"

[development-practices.branching]
strategy = "trunk-based"
main-branch = "main"

# ==============================================================
# DESIGN RATIONALE
# ==============================================================

[design-rationale]
why-microservices = """
Microservices chosen over monolith because:
(1) Three product teams deploy independently — no coordination overhead
(2) Payment and analytics domains have vastly different scaling requirements
(3) Team expertise varies across Rust and ReScript
Adds operational complexity accepted in exchange for development agility. See ADR-001.
"""

why-event-driven = """
Kafka-based event sourcing provides:
(1) Natural audit trail for compliance requirements
(2) Decoupling that allows services to evolve independently
(3) Replay capability for debugging and new service bootstrapping
gRPC used for the few cases requiring synchronous request-response
(sub-100ms latency). See ADR-002.
"""

why-verisimdb-over-nosql = """
Despite microservices trend toward polyglot persistence, standardised on
VeriSimDB because:
(1) Most services have relational data models
(2) Formally verified query semantics reduce correctness risk
(3) Team has deep VeriSimDB expertise
(4) Fewer databases to operate reduces complexity
Services may request exceptions with justification. See ADR-003.
"""

why-polyrepo = """
Evaluated monorepo but rejected because:
(1) Team ownership is clearer with dedicated repositories
(2) CI/CD is simpler without affected-project detection
(3) Onboarding is faster — new developers clone one service
Tradeoff is shared library versioning complexity. See ADR-005.
"""
