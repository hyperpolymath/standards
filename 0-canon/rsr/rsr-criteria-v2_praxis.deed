    (criterion :id "8.1.4" :name no-scaffold-stub :desc "No scaffold-stub guix.scm (placeholders / empty inputs / source #f)" :tier silver :gate reproducible-build :detect structural_drift/SD021 :template-ref "-")
  )
  (category :id 9 :key web-service-standards :name "Web & Service Standards" :weight 3
    (criterion :id "9.1.1" :name tls13 :desc "TLS 1.3 only for deployed endpoints" :tier gold :gate api-service :detect manual :template-ref "-")
    (criterion :id "9.1.2" :name csp-hsts :desc "Content-Security-Policy + HSTS on web surfaces" :tier gold :gate web-ui :detect manual :template-ref "-")
