;; ECOSYSTEM.a2ml - Ecosystem position for agentic-a2ml
;; Media-Type: application/vnd.ecosystem+a2ml

(ecosystem
  (version "1.0")
  (name "agentic-a2ml")
  (type "specification")
  (purpose "Define operational gating format for AI agent safety")

  (position-in-ecosystem
    (category "standards")
    (subcategory "a2ml-format-family")
    (tier "execution")
    (unique-value
      ("Entropy budget tracking"
       "Risk threshold classification"
       "Explicit intent verification"
       "Decision audit trails")))

  (related-projects
    ((name "standards")
     (relationship "parent")
     (url "https://github.com/hyperpolymath/standards"))
    ((name "meta-a2ml")
     (relationship "constitutional-authority")
     (url "https://github.com/hyperpolymath/standards/tree/main/meta-a2ml"))
    ((name "playbook-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/playbook-a2ml"))
    ((name "neurosym-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/neurosym-a2ml"))
    ((name "anchor-a2ml")
     (relationship "intervention-layer")
     (url "https://github.com/hyperpolymath/standards/tree/main/anchor-a2ml")))

  (what-this-is
    ("Operational gating specification"
     "AI agent safety controls"
     "Entropy budget tracking system"
     "Risk classification framework"
     "Confirmation requirement definitions"
     "Decision audit trail format"))

  (what-this-is-not
    ("Constitutional authority (that's META)"
     "Executable plans (that's PLAYBOOK)"
     "Symbolic semantics (that's NEUROSYM)"
     "Implementation code")))
