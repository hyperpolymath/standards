[metadata]
schema = "session-management-state-template"
family = "continuity"
protocol = "planned-session-close"
status = "active"
version = "1.1.0"

[attributes]
protocol = "continuity / planned-session-close"
protocol_version = "1.1.0"
session_id = ""
session_start = ""
session_end = ""
assistant = ""
author = ""
format_schema = "session-close.v1.enriched"
archival_convention = "timestamped append-only"
cross_references = []

[continuity_core]
goal = ""
current_task = ""
last_completed_action = ""
next_intended_action = ""
repository = ""
branch = ""
head_commit = { repo = "", hash = "", subject = "" }
files_of_interest = []
known_blockers = []
residual_risks = []
recommended_next_protocol = ""

[tables]
commits_made = []
verifications_run = []
risk_register_delta = []
discipline_check = []

[lists]
decisions_made = []
decisions_deferred = []
open_invitations = []
memory_entries = []
standing_reminders = []
