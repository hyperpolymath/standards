# Machine protocol contract for planned-session-close
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath)
protocol:
  family: "continuity"
  name: "planned-session-close"
  canonical_command: "close planned <path>"
  status: "active"
  version: "1.1.0"

continuity_core:
  # Metadata
  - protocol
  - protocol_version
  - session_id
  - session_start
  - session_end
  - assistant
  - author
  - format_schema
  - archival_convention
  - cross_references
  # Core Content
  - goal
  - current_task
  - last_completed_action
  - next_intended_action
  - repository
  - branch
  - head_commit
  - files_of_interest
  - known_blockers
  - residual_risks
  - recommended_next_protocol
  # Tables/Lists
  - commits_made
  - verifications_run
  - decisions_made
  - decisions_deferred
  - open_invitations
  - memory_entries
  - risk_register_delta
  - discipline_check

outputs:
  - path: "SESSION-CLOSE-<ISO-DATE>-<TOPIC>.adoc"
    format: "asciidoc"
    schema: "session-close.v1.enriched"
    grounding: "required"
    archival: "append-only"
