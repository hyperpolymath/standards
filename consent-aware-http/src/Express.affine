// Express.js bindings. AffineScript port of Express.res.

module Express;

pub type Req = {
  headers: Dict<String>,
  path: String,
}

extern type Res;

extern fn status(r: Res, code: Int) -> Res = "express" "status";
extern fn header(r: Res, name: String, value: String) -> Res = "express" "header";
extern fn json(r: Res, body: a) -> Unit = "express" "json";

pub type Next = fn() -> Unit;
pub type Middleware = fn(Req, Res, Next) -> Promise<Unit>;
