(repo-deed
  :schema-version "1.0.0"
  :canonical-name "standards"
  :repo-uuid #u8"gv-clade-index:github.com/hyperpolymath/standards"
  :beholding-chora #u5"estate/chora"
  (identity :owner "hyperpolymath" :primary-forge github)
  (front-doors :human "README.adoc" :agent ".machine_readable/descriptiles/0-AI-MANIFEST.deed")
  (authority
    :constitution "0-canon/constitution/"
    :licensing "3-practice/LICENCE-POLICY.adoc"
    :agent-policy ".claude/CLAUDE.md")
  (routing
    :deed "1-formats/deed/"
    :contracts "1-formats/k9/"
    :coordination "2-protocols/k9-coordination/"
    :enforcement ".github/workflows/"
    :governance "3-practice/fork-governance/")
  (status
    :phase active
    :maturity experimental
    :evidence-status "Present-tense state is this deed. The STATE journal was not translated and stays archived.")
  (agentic
    (profile :id "a2ml/agentic")
    :version "0.1.0"
    :last-updated "2026-04-11"
    (permissions :source #t :tests #t :docs #t :config #t :create-files #t)
    (integrity :fail-closed #t :require-evidence-per-step #t :allow-silent-skip #f :require-rerun-after-fix #t :release-claim-requires-hard-pass #t))
  (neurosym
    (profile :id "a2ml/neurosym")
    :version "0.1.0"
    :last-updated "2026-04-11"
    (hypatia :scan-enabled #t :scan-depth standard :report-format "logtalk"))
  (playbook
    (profile :id "a2ml/playbook")
    :version "0.1.0"
    :last-updated "2026-04-11")
  (meta
    :version "1.0.0"
    :last-updated "2026-05-15"
    :license MPL-2.0
    :author "Jonathan D.A. Jewell (hyperpolymath)"
    :build-tool just
    :documentation AsciiDoc
    :versioning SemVer
    :scoping-first #t
    :axis-1 "must > intend > like"
    :axis-2 "corrective > adaptive > perfective"
    :axis-3 "systems > compliance > effects"
    (adr :id "ADR-001" :date "2026-05-15" :title "CODEOWNERS policy for hyperpolymath repos" :status accepted :ref "3-practice/CODEOWNERS-POLICY.adoc" :issue "standards#55" :summary "Solo-owned repos carry no catch-all CODEOWNERS lines; path lines stay only for genuine co-owners."))
  (ecosystem
    (profile :id "a2ml/ecosystem")
    :version "1.0.0"
    :last-updated "2026-04-11"
    :project "Standards"
    :purpose "Part of hyperpolymath ecosystem"
    :role component)
  (clade
    :primary gv
    :phase active
    :present #t
    :since "2026-03-16"
    :lineage-type monorepo
    :born "2026-03-16"
    :github "hyperpolymath/standards"
    :note "The archived CLADE uuid did not re-derive. It was not copied. Identity is :repo-uuid on this deed.")
  (policies
    (licensing
      :initial-assignment "Agents may author new files with the correct SPDX under repository policy, and initialise a brand-new repository's LICENSE."
      :existing-declarations "Manual-Only; changes restricted to registered codeowner-admins. Agents flag drift and never sweep or relicense existing content.")))
