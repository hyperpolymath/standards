// FFI bindings for @std/fs. AffineScript port of Deno_Std_Fs.res.

module Deno_Std_Fs;

pub type WalkEntry = {
  path: String,
  name: String,
  is_file: Bool,
  is_directory: Bool,
  is_symlink: Bool,
}

pub type WalkOptions = { exts: Option<[String]> }

// walk returns an async iterable; collect into array via for-await glue.
extern fn walk(root: String, options: WalkOptions) -> AsyncIterable<WalkEntry> = "@std/fs" "walk";
