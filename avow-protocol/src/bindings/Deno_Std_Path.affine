// FFI bindings for @std/path. AffineScript port of Deno_Std_Path.res.

module Deno_Std_Path;

extern fn relative(from: String, to: String) -> String = "@std/path" "relative";
extern fn basename(path: String) -> String = "@std/path" "basename";
extern fn join(a: String, b: String) -> String = "@std/path" "join";
extern fn dirname(path: String) -> String = "@std/path" "dirname";
