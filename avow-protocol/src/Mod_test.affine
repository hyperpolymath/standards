// AffineScript port of Mod_test.res.

module Mod_test;

use Mod;

extern fn assert_equals(a: a, b: a) -> Unit = "@std/assert" "assertEquals";
extern fn deno_test(name: String, body: fn() -> Unit) -> Unit = "Deno" "test";

deno_test("addTest", fn() {
  assert_equals(Mod.add(2.0, 3.0), 5.0)
})
