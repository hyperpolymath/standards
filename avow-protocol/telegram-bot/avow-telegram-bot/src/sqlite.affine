//
// FFI bindings for SQLite (deno.land/x/sqlite).
// AffineScript port of Sqlite.res.

module Sqlite;

extern type Db;

extern fn make_db(path: String) -> Db = "https://deno.land/x/sqlite@v3.9.1/mod.ts" "DB";
extern fn execute(d: Db, sql: String) -> Unit = "sqlite" "execute";
extern fn query(d: Db, sql: String, params: [Json]) -> [[Json]] = "sqlite" "query";
extern fn close(d: Db) -> Unit = "sqlite" "close";
