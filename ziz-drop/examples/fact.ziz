; Run with:  ziz0 --file=examples/fact.ziz --jeg=observe
; No typechecker. The JEG records what was *observed*: fact was applied
; with arity 1, took :int, returned :int. Nobody declared that; it was seen.

(define (fact n)
  (if (= n 0)
      1
      (* n (fact (- n 1)))))

(claim fact :arity 1 :evidence :asserted)
(claim fact :pure   :evidence :asserted :by "author")

(print (fact 10))
