; Homoiconicity: code is a list; lists are code.

(define code '(+ 1 2 3))
(print code)                 ; (+ 1 2 3)
(print (car code))           ; +
(print (eval code))          ; 6

(define (make-adder-form n) `(lambda (x) (+ x ,n)))
(define add5 (eval (make-adder-form 5)))
(print (add5 10))            ; 15
