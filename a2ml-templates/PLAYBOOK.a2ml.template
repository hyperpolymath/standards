# SPDX-License-Identifier: MPL-2.0
# PLAYBOOK.a2ml - Operational runbook
# Template from: https://github.com/hyperpolymath/standards
#
# HUMAN SUMMARY: This is the project's "how to operate it" guide in
# machine-readable form. It lists build commands, deployment steps,
# debugging procedures, rollback plans, and alert thresholds. Both
# humans and CI/CD bots read this to know how to work with the project.

# ── Playbook Identity ─────────────────────────────────────────────────────
[playbook]
# version: Format version for this file.
version = "1.0.0"

# project: Must match the repo name exactly.
project = "{{PROJECT_NAME}}"

# ── Build Procedures ──────────────────────────────────────────────────────
[playbook.procedures.build]
# check: Run lints and static analysis (should be fast, <30s).
check = "just check"

# build: Compile the project (may be slow for large projects).
build = "just build"

# test: Run the test suite.
test = "just test"

# ── Deployment Procedures ─────────────────────────────────────────────────
[playbook.procedures.deploy]
# release: Create a tagged release.
release = "just release"

# ── Debugging Procedures ──────────────────────────────────────────────────
[playbook.procedures.debug]
# logs: View application logs.
logs = "just logs"

# repl: Start an interactive session for debugging.
repl = "just repl"

# ── Rollback Procedures ──────────────────────────────────────────────────
[playbook.procedures.rollback]
# Steps to undo a bad deployment. Fill in project-specific commands.
# Example:
#   revert = "git revert HEAD && just deploy"

# ── Alerts ────────────────────────────────────────────────────────────────
[playbook.alerts]
# Alert definitions and thresholds. Example:
#   [playbook.alerts.build-failure]
#   severity = "high"
#   channel = "ci-failures"
#   condition = "build exit code != 0"

# ── Contacts ─────────────────────────────────────────────────────────────
[playbook.contacts]
# On-call and escalation contacts. Example:
#   maintainer = "Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"

# ── Provenance ─────────────────────────────────────────────────────────────
[provenance]
# Audit trail — updated automatically by agents/bots on every write.
# Humans: you can ignore this section, but don't delete it.
last-modified-by = "{{AGENT_ID}}"
last-modified-at = "{{TIMESTAMP}}"
last-session-id = ""
git-sha-at-read = ""
modification-summary = "Initial creation from template"
