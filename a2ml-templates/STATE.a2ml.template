# SPDX-License-Identifier: PMPL-1.0-or-later
# STATE.a2ml - RSR State File
# Template from: https://github.com/hyperpolymath/standards
#
# This file tracks the current state of the project using A2ML key-value format.
# It is machine-readable and used by RSR tooling for validation.

[state]
version = "0.1.0"
phase = "{{PHASE}}"  # concept, alpha, beta, stable, mature
updated = "{{TIMESTAMP}}"

[state.project]
name = "{{PROJECT_NAME}}"
tier = "{{TIER}}"  # core, infrastructure, experimental, playground
license = "PMPL-1.0-or-later"
language = "{{PRIMARY_LANGUAGE}}"

[state.compliance]
rsr = true
security-hardened = true
ci-cd = true
guix-primary = false
nix-fallback = false

[state.artifacts]
# Build outputs

[state.dependencies]
build = []
runtime = []

[state.milestones.v0_1_0]
status = "planned"
features = [
  "Initial framework",
  "Basic examples",
  "Documentation",
]
