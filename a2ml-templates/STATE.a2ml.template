# SPDX-License-Identifier: AGPL-3.0-or-later
# STATE.a2ml - RSR State File
# Template from: https://github.com/hyperpolymath/standards
#
# This file tracks the current state of the project using A2ML key-value format.
# It is machine-readable and used by RSR tooling for validation.
#
# HUMAN SUMMARY: This is your project's "status dashboard". It tells anyone
# (human or AI) where the project is right now — what phase it's in, what's
# been built, and what's next. Update it as work progresses.

# ── Project State ──────────────────────────────────────────────────────────
[state]
# version: Semantic version of this project (not the state file format).
version = "0.1.0"

# phase: What development stage is this project in?
#   concept  — idea only, no code yet
#   alpha    — internally dogfooded hard enough to absorb the first wave of breakage
#   beta     — seen behaving as a release beyond this repo; external release exposure exists
#   stable   — passed the stable release gate; audited, not merely feature-complete
#   mature   — full-release standing; best-practice operational gaps closed
phase = "{{PHASE}}"

# updated: ISO 8601 timestamp of last state change.
updated = "{{TIMESTAMP}}"

# ── Project Identity ───────────────────────────────────────────────────────
[state.project]
# name: Human-readable project name. Must match repo name.
name = "{{PROJECT_NAME}}"

# tier: Where does this sit in the ecosystem?
#   core           — essential infrastructure, high stability bar
#   infrastructure — supporting tooling
#   experimental   — proof of concept, may be discarded
#   playground     — learning/sandbox, no stability promises
tier = "{{TIER}}"

# license: SPDX identifier. Almost always PMPL-1.0-or-later.
license = "PMPL-1.0-or-later"

# language: Primary programming language used.
language = "{{PRIMARY_LANGUAGE}}"

# ── Compliance Flags ───────────────────────────────────────────────────────
[state.compliance]
# rsr: Does this repo meet Rhodium Standard Repository requirements?
rsr = true

# security-hardened: Are security workflows (CodeQL, Scorecard, etc.) active?
security-hardened = true

# ci-cd: Is CI/CD configured and running?
ci-cd = true

# guix-primary: Is Guix the primary package manager?
guix-primary = false

# nix-fallback: Is Nix configured as a fallback?
nix-fallback = false

# ── Build Artifacts ────────────────────────────────────────────────────────
[state.artifacts]
# List notable build outputs here (binaries, WASM, libraries, etc.)

# ── Dependencies ───────────────────────────────────────────────────────────
[state.dependencies]
# build: Dependencies needed at build time only.
build = []

# runtime: Dependencies needed at runtime.
runtime = []

# ── Milestones ─────────────────────────────────────────────────────────────
[state.milestones.v0_1_0]
# status: "planned", "in-progress", "complete", or "cancelled"
status = "planned"

# features: What this milestone delivers.
features = [
  "Initial framework",
  "Basic examples",
  "Documentation",
]

# ── Provenance ─────────────────────────────────────────────────────────────
[provenance]
# Audit trail — updated automatically by agents/bots on every write.
# Humans: you can ignore this section, but don't delete it.
last-modified-by = "{{AGENT_ID}}"
last-modified-at = "{{TIMESTAMP}}"
last-session-id = ""
git-sha-at-read = ""
modification-summary = "Initial creation from template"
