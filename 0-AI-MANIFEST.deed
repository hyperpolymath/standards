;; SPDX-License-Identifier: CC-BY-SA-4.0
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "github.com/hyperpolymath/standards"
  :repo-uuid #u8"gv-clade-index:github.com/hyperpolymath/standards"
  :beholding-chora #u5"estate/chora"

  (purpose
    "The organization-wide standards monorepo: ~30 specs that govern every Hyperpolymath project — K9 self-validating components, the protocols, the readiness-grading frameworks (ARG/FRG/CRG/TRG), RSR compliance, and the enforcement/CI that makes them stick.")

  (front-doors
    :machine "0-AI-MANIFEST.deed"
    :human "README.adoc")

  (routing
    (k9-foundation "1-formats/k9/" "1-formats/contractiles/")
    (language-policy ".claude/CLAUDE.md")
    (protocols "*-protocol/")
    (readiness-grades "adoption-readiness-grades/" "foundations-readiness-grades/" "component-readiness-grades/" "toolchain-readiness-grades/")
    (multi-repository-scope "docs/MULTI-REPOSITORY-SCOPE-STANDARD.adoc" "docs/repo-scope.example.toml")
    (enforcement-ci ".github/workflows/" "hooks/")
    (drift-automation "hypatia-rules/" "docs/decisions/ADR-003-workflow-pin-staleness-window.adoc" "scripts/check-workflow-staleness.sh" "scripts/propagate-workflow-pins.sh")
    (derived-architecture-map "TOPOLOGY.adoc")
    (current-project-state ".machine_readable/descriptiles/STATE.deed")
    (education-layer "docs/wikis/" "docs/wikis/0.2-AI-MANIFEST.deed"))

  (invariants
    (rule :priority 10 "No A2ML/DEED duplication — root must NOT contain STATE.deed, META.deed, etc.")
    (rule :priority 20 "Single source of truth — .machine_readable/descriptiles/ is authoritative for state.")
    (rule :priority 30 "Licence changes are Manual-Only, owner-only. Agents may add the correct SPDX header when creating a new file, following the repo's licence classification. Agents NEVER edit, sweep, or relicense existing LICENSE files or SPDX headers; licence drift is FLAG-ONLY (:review). See LICENSE, .machine_readable/licensing-policy.toml, and .claude/CLAUDE.md.")
    (rule :priority 40 "Author attribution — Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"))

  (startup-checklist
    "Read THIS file, then README.adoc."
    "Read .machine_readable/descriptiles/STATE.deed for current status + blockers."
    "Read .machine_readable/descriptiles/AGENTIC.deed for interaction patterns."
    "Read .claude/CLAUDE.md for the language + licence policy (binding).")

  (attestation
    "I have read the standards manifest. The human front door is README.adoc. Licence/SPDX changes to existing files are Manual-Only — I will flag, never edit. I may add the correct SPDX header when creating a new file, following the repo's licence classification.")

  (meta
    :maintained-by "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"
    :protocol "https://github.com/hyperpolymath/0-ai-gatekeeper-protocol")
)
