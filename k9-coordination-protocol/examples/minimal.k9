K9!
# SPDX-License-Identifier: AGPL-3.0-or-later
# minimal.k9 — Minimal coordination.k9 example
#
# This is the smallest useful coordination file. It declares the project
# identity and a few critical invariants. Even this much prevents the
# most common AI agent mistakes.

---
metadata:
  schema: k9-coordination
  schema_version: 1.0.0
  last_updated: 2026-04-03

project:
  name: "my-project"
  description: "A brief description of what this project does"
  license: PMPL-1.0-or-later
  languages:
    - Rust
    - ReScript
  build_system: just
  runtime: deno

invariants:
  - id: no-typescript
    rule: "Do not introduce TypeScript — ReScript is the frontend language"
    reason: "Deliberate ecosystem choice"
    severity: critical

  - id: no-docker
    rule: "Use Containerfile, not Dockerfile — Podman is the container runtime"
    reason: "Docker is not used in this ecosystem"
    severity: high

protected:
  - path: .machine_readable/
    reason: "Canonical location for A2ML state files"
  - path: coordination.k9
    reason: "Source of truth for AI coordination"
