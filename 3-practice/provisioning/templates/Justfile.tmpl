#
# __APP_NAME__ — every task is a recipe here; `just` lists them.
# The provisioning contract (setup doctor heal eval dev-shell toolchain-refresh
# ai-setup ai-warmup config-show opsm) comes from build/just/provision.just, and
# the per-language defaults for build/test/bench/lint/fmt/fmt-check/run from the same
# module. Define a recipe here to override one for this repository.
# Needs just >= 1.42 (a root recipe depending on a module recipe, e.g. `doctor: provision::doctor`).

mod provision 'build/just/provision.just'

# List every recipe
default:
    @just --list --list-submodules

__DELEGATIONS__
