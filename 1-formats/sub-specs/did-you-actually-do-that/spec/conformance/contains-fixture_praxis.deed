;; Conformance vector contains-fixture. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "contains-fixture"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class file-changed :verifier git-diff :expect "contains:DYADT fixture" :target "1-formats/sub-specs/did-you-actually-do-that/spec/conformance/fixture.txt" :statement "the fixture contains the marker")
)
