;; SPDX-License-Identifier: MPL-2.0
;; Conformance vector manual-licence. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "manual-licence"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class file-changed :verifier git-diff :expect "contains:SPDX-License-Identifier" :target "some/file.rs" :statement "SPDX licence header added")
)
