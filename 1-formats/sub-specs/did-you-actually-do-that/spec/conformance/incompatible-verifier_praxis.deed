;; Conformance vector incompatible-verifier. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "incompatible-verifier"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class pr-merged :verifier command-transcript :expect "merged==true" :target "hyperpolymath/standards#454" :statement "PR merged, but checked with the wrong verifier")
)
