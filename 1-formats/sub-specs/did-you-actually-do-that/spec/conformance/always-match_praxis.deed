;; Conformance vector always-match. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "always-match"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class file-changed :verifier git-diff :expect "contains:.*" :target "README.adoc" :statement "a vacuous always-matching contains pattern")
)
