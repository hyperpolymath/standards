;; Conformance vector refuted-command. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "refuted-command"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class command-ran :verifier command-transcript :expect "exit==0" :target "false" :statement "false is claimed to succeed")
)
