;; SPDX-License-Identifier: MPL-2.0
;; Conformance vector unsafe-path. The .a2ml copy is archived.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "unsafe-path"
  :beholding-chora #u5"estate/chora"
  (claim :id C1 :claim-class file-changed :verifier git-diff :expect "created" :target "../../etc/passwd" :statement "a path-traversal target")
)
