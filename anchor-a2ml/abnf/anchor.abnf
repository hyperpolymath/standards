;
; ANCHOR Grammar, v1.0.0 DRAFT
; Normative for parsing *.anchor files.
;
; Lexical layer shared with deed.abnf (comments, tokens, primitives).
; Structural layer is ANCHOR-specific.
;
; ANCHOR is NOT a DEED. It is an ephemeral intervention document
; that references DEED for target identity.

anchor-file     = header [token-sep] anchor-form [token-sep]
                  ; IMPLEMENTATION: entire input MUST be consumed.

header          = 1*spdx-line
spdx-line       = ";;" SP %s"SPDX-" 1*text-char line-end

anchor-form     = "(" %s"anchor" token-sep
                  1*(token-sep (field / clause)) [token-sep] ")"
                  ; SEMANTIC: MUST contain exactly one of each:
                  ;   :schema-version, :target-chora,
                  ;   (authority ...), (purpose ...),
                  ;   (directives ...), (verification ...)

; --- Authority -----------------------------------------------------

authority-clause = "(" %s"authority"
                   token-sep %s":superintendent" token-sep string
                   token-sep %s":role" token-sep string
                   [token-sep %s":contact" token-sep string]
                   [token-sep %s":level" token-sep auth-level]
                   [token-sep %s":scope" token-sep string]
                   [token-sep] ")"

auth-level      = %s"full" / %s"scoped" / %s"advisory"

; --- Purpose -------------------------------------------------------

purpose-clause  = "(" %s"purpose"
                  token-sep %s":type" token-sep purpose-type
                  token-sep %s":summary" token-sep string
                  [token-sep %s":symptoms" token-sep string-list]
                  [token-sep %s":desired-outcome" token-sep string-list]
                  [token-sep] ")"

purpose-type    = %s"scope-arrest"
                / %s"direction-change"
                / %s"stock-taking"
                / %s"emergency-halt"
                / %s"course-correction"

; --- Directives ----------------------------------------------------

directives-clause = "(" %s"directives"
                    1*(token-sep directive-entry) [token-sep] ")"

directive-entry = "(" %s"directive"
                  token-sep %s":action" token-sep string
                  token-sep %s":priority" token-sep priority
                  [token-sep %s":description" token-sep string]
                  [token-sep %s":deadline" token-sep date]
                  [token-sep %s":phase" token-sep phase]
                  [token-sep] ")"

priority        = %s"critical" / %s"high" / %s"medium"
                / %s"normal" / %s"low"

phase           = %s"immediate" / %s"this-week"
                / %s"this-month" / %s"ongoing"

; --- Target Review -------------------------------------------------

target-review-clause = "(" %s"target-review"
                       1*(token-sep review-entry) [token-sep] ")"

review-entry    = "(" %s"review"
                  token-sep %s":target" token-sep symbol
                  token-sep %s":required" token-sep boolean
                  [token-sep %s":focus" token-sep string-list]
                  [token-sep] ")"

; --- Verification --------------------------------------------------

verification-clause = "(" %s"verification"
                      1*(token-sep criterion-entry) [token-sep]
                      [token-sep %s":method" token-sep string]
                      [token-sep %s":reviewer" token-sep string]
                      [token-sep %s":deadline" token-sep date]
                      [token-sep] ")"

criterion-entry = "(" %s"criterion"
                  token-sep %s":name" token-sep symbol
                  token-sep %s":measure" token-sep string
                  [token-sep] ")"

; --- Temporal Fields -----------------------------------------------
; These appear as top-level fields in the anchor-form.

; :issued DATE          — when this anchor was created (REQUIRED)
; :expires DATE         — when this anchor becomes advisory (REQUIRED)
; :supersedes UUID5     — prior anchor this replaces (OPTIONAL)
; :target-chora UUID5   — the repo chora this anchor targets (REQUIRED)

; --- Shared Primitives (imported from deed.abnf) -------------------

field           = keyword token-sep value
clause          = "(" symbol *(token-sep (field / clause)) [token-sep] ")"
keyword         = ":" symbol
value           = string / symbol / integer / boolean / uuid5 / list
list            = "(" [value *(token-sep value)] [token-sep] ")"
string-list     = "(" [string *(token-sep string)] [token-sep] ")"

string          = DQUOTE *( str-char / escape ) DQUOTE
str-char        = %x20-21 / %x23-5B / %x5D-7E / UTF8-2 / UTF8-3 / UTF8-4
escape          = "\" ( DQUOTE / "\" / %s"n" / %s"t" )
symbol          = ALPHA *( ALPHA / DIGIT / "." / "*" / "/" / "<" / ">"
                         / "=" / "!" / "?" / "+" / "-" / "_" )
integer         = [ "-" ] 1*DIGIT
boolean         = %s"#t" / %s"#f"
uuid5           = %s"#u5" string
date            = 4DIGIT "-" 2DIGIT "-" 2DIGIT

token-sep       = 1*(SP / line-end / comment)
line-end        = CRLF / LF
comment         = ";" *text-char line-end
text-char       = VCHAR / SP / UTF8-2 / UTF8-3 / UTF8-4

UTF8-2          = %xC2-DF UTF8-tail
UTF8-3          = %xE0 %xA0-BF UTF8-tail / %xE1-EC 2UTF8-tail
                / %xED %x80-9F UTF8-tail / %xEE-EF 2UTF8-tail
UTF8-4          = %xF0 %x90-BF 2UTF8-tail / %xF1-F3 3UTF8-tail
                / %xF4 %x80-8F 2UTF8-tail
UTF8-tail       = %x80-BF
