;; ECOSYSTEM.a2ml - Ecosystem position for anchor-a2ml
;; Media-Type: application/vnd.ecosystem+a2ml

(ecosystem
  (version "1.0")
  (name "anchor-a2ml")
  (type "specification")
  (purpose "Define project recalibration and realignment format")

  (position-in-ecosystem
    (category "standards")
    (subcategory "scm-format-family")
    (tier "intervention")
    (unique-value
      ("Superintendent authority declarations"
       "Scope arrest directives"
       "SCM file review guidance"
       "Verification criteria")))

  (related-projects
    ((name "standards")
     (relationship "parent")
     (url "https://github.com/hyperpolymath/standards"))
    ((name "meta-a2ml")
     (relationship "target-of-intervention")
     (url "https://github.com/hyperpolymath/standards/tree/main/meta-a2ml"))
    ((name "playbook-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/playbook-a2ml"))
    ((name "agentic-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/agentic-a2ml"))
    ((name "neurosym-a2ml")
     (relationship "sibling")
     (url "https://github.com/hyperpolymath/standards/tree/main/neurosym-a2ml")))

  (what-this-is
    ("Intervention layer specification"
     "Project recalibration format"
     "Scope arrest directives"
     "AI agent realignment tool"
     "Superintendent authority declarations"))

  (what-this-is-not
    ("Constitutional authority (that's META)"
     "Operational gating (that's AGENTIC)"
     "Executable plans (that's PLAYBOOK)"
     "Symbolic semantics (that's NEUROSYM)"
     "Implementation code")))
