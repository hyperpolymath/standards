{
  "_comment": "PanLL panel manifest. Panels emit A2ML internally; this manifest matches the PanelHarness JSON schema (pre-standards).",
  "version": "0.1.0",
  "workspace": "standards",
  "data_source": "verisimdb://standards:8097",
  "panels": [
    {
      "id": "standards-crg-dashboard",
      "title": "CRG Dashboard",
      "description": "Component readiness grades across 290+ repos",
      "module": "CrgDashboard.res",
      "refresh_interval_s": 60,
      "default_layout": { "w": 8, "h": 6 }
    },
    {
      "id": "standards-compliance-monitor",
      "title": "Standards Compliance Monitor",
      "description": "Hypatia findings heatmap",
      "module": "ComplianceMonitor.res",
      "refresh_interval_s": 30,
      "default_layout": { "w": 12, "h": 8 }
    },
    {
      "id": "standards-proof-hub",
      "title": "Proof Verification Hub",
      "description": "Formal proof status and axiom usage",
      "module": "ProofHub.res",
      "refresh_interval_s": 120,
      "default_layout": { "w": 8, "h": 6 }
    }
  ]
}
