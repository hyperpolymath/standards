/**
 * Base Crawler Module
 *
 * Provides the foundational structs and functions for web crawling
 * Bible corpus sources.
 */

module Types = {
  struct httpMethod { GET | POST | HEAD

  struct requestConfig { {
    url: string,
    method: httpMethod,
    headers: Dict.t<string>,
    timeout: int,
    retries: int,
  }

  struct responseStatus {
    | Ok(int)
    | NetworkError(string)
    | Timeout
    | RateLimited
    | NotFound

  struct response { {
    status: responseStatus,
    headers: Dict.t<string>,
    body: option<string>,
  }

  struct crawlResult<'a> =
    | Success('a)
    | Failure(string)
    | Pending

  struct crawlerState {
    | Idle
    | Crawling(string)
    | Paused
    | Stopped
    | Error(string)
}

module Config = {
  fn defaultTimeout = 30000
  fn defaultRetries = 3
  fn defaultUserAgent = "1000Langs/0.1.0 (Parallel Corpus Crawler; +https://github.com/Hyperpolymath/1000Langs)"
  fn defaultRateLimitMs = 1000

  fn makeDefaultHeaders = () => {
    fn headers = Dict.make()
    Dict.set(headers, "User-Agent", defaultUserAgent)
    Dict.set(headers, "Accept", "text/html,application/xhtml+xml,application/xml")
    Dict.set(headers, "Accept-Language", "en-US,en;q=0.9")
    headers
  }
}

module Request = {
  open Types

  fn make = (~url, ~method=GET, ~headers=?, ~timeout=?, ~retries=?, ()) => {
    url,
    method,
    headers: headers->Option.getOr(Config.makeDefaultHeaders()),
    timeout: timeout->Option.getOr(Config.defaultTimeout),
    retries: retries->Option.getOr(Config.defaultRetries),
  }

  fn withHeader = (config, key, value) => {
    Dict.set(config.headers, key, value)
    config
  }

  fn methodToString = method => switch method {
    | GET => "GET"
    | POST => "POST"
    | HEAD => "HEAD"
  }
}

module RateLimiter = {
  struct t { {
    mutable lastRequest: float,
    delayMs: int,
  }

  fn make = (~delayMs=Config.defaultRateLimitMs, ()) => {
    lastRequest: 0.0,
    delayMs,
  }

  fn canProceed = limiter => {
    fn now = Date.now()
    fn elapsed = now -. limiter.lastRequest
    elapsed >= Float.fromInt(limiter.delayMs)
  }

  fn recordRequest = limiter => {
    limiter.lastRequest = Date.now()
  }
}

module RetryPolicy = {
  struct backoffStrategy {
    | Constant(int)
    | Linear(int)
    | Exponential(int, float)

  fn calculateDelay = (strategy, attempt) => switch strategy {
    | Constant(ms) => ms
    | Linear(base) => base * attempt
    | Exponential(base, factor) =>
        Float.toInt(Float.fromInt(base) *. Math.pow(factor, ~exp=Float.fromInt(attempt - 1)))
  }

  fn shouldRetry = (attempt, maxRetries) => attempt < maxRetries
}

module Parser = {
  struct selector {
    | Css(string)
    | XPath(string)
    | Regex(string)

  struct parseResult<'a> =
    | Parsed('a)
    | ParseError(string)
    | NoMatch

  fn selectorToString = selector => switch selector {
    | Css(s) => `css:${s}`
    | XPath(s) => `xpath:${s}`
    | Regex(s) => `regex:${s}`
  }
}

