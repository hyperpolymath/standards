// AffineScript port of Types.res.

module Types;

extern type Date;

pub type CanonicalLocations = {
  scm_files: String,
  bot_directives: String,
  agent_instructions: [String],
}

pub type AiManifest = {
  hash: String,
  canonical_locations: CanonicalLocations,
  invariants: [String],
  parsed_at: Date,
}

pub type SessionState = {
  session_id: String,
  acknowledged_manifest: Bool,
  attestation_hash: Option<String>,
  acknowledged_at: Option<Date>,
  repo_path: String,
}

pub type AccessResult = {
  allowed: Bool,
  reason: Option<String>,
}

pub type GuardianConfig = {
  base_path: String,
  strict_mode: Bool,
  session_timeout: Int,
}
