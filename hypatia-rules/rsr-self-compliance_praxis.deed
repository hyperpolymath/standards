;; Hypatia rule rsr-self-compliance. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "rsr-self-compliance"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/rsr-self-compliance.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S004\nname: \"RSR self-compliance\"\ndescription: \"Standards repo must satisfy every requirement it imposes on others\"\nseverity: critical\ncategory: Dogfooding\nauto_fixable: false\nsource: standards/hypatia-rules")
  (scanner :type file-tree :body "target_repo: \"standards\"\nreference: \"rhodium-standard-repositories/RSR.adoc\"")
  (required_files :body "# RSR-mandated files that standards itself must have\n- path: \"README.adoc\"\n  reason: \"RSR R-001\"\n- path: \"3-practice/SECURITY.md\"\n  reason: \"RSR R-002\"\n- path: \"CONTRIBUTING.md\"\n  reason: \"RSR R-003\"\n- path: \"LICENSE\"\n  reason: \"RSR R-004\"\n- path: \"CODE_OF_CONDUCT.md\"\n  reason: \"RSR R-005\"\n- path: \".editorconfig\"\n  reason: \"RSR R-010\"\n- path: \"Justfile\"\n  reason: \"RSR R-020 (no Makefiles)\"\n- path: \"guix.scm\"\n  reason: \"RSR R-030 (primary pkg manager)\"\n- path: \"flake.nix\"\n  reason: \"RSR R-031 (fallback pkg manager)\"\n- path: \".machine_readable/\"\n  reason: \"RSR R-040 (A2ML metadata)\"")
  (required_workflows :body "- name: \"hypatia-scan.yml\"\n  reason: \"RSR R-050 (self-scan)\"\n- name: \"mirror.yml\"\n  reason: \"RSR R-051 (forge mirroring)\"\n- name: \"scorecard.yml\"\n  reason: \"RSR R-052 (OpenSSF Scorecard)\"\n- name: \"rsr-antipattern.yml\"\n  reason: \"RSR R-053 (antipattern check)\"")
  (forbidden_files :body "- glob: \"**/*.ts\"\n  reason: \"TypeScript banned — use AffineScript (RS/TS/JS → AffineScript → typed-wasm per estate language defaults)\"\n- glob: \"**/*.res\"\n  reason: \"ReScript banned — use AffineScript (RS/TS/JS → AffineScript → typed-wasm per estate language defaults)\"\n- glob: \"**/*.py\"\n  reason: \"Python banned\"\n- glob: \"**/*.go\"\n  reason: \"Go banned — use Rust\"\n- glob: \"Dockerfile\"\n  reason: \"Use Containerfile (Podman)\"\n- glob: \"Makefile\"\n  reason: \"Use Justfile\"\n- glob: \"STATE.a2ml\"\n  at: \"/\"\n  reason: \"A2ML files go in .machine_readable/ only\"")
  (action :body "emit_signal: compliance.finding.new\nmessage_template: \"RSR self-compliance violation: {reason} ({path})\"\nrecipe: none\nhalt_on_violation: true")
)
