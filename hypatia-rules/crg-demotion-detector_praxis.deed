;; Hypatia rule crg-demotion-detector. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "crg-demotion-detector"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/crg-demotion-detector.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S001\nname: \"CRG demotion detector\"\ndescription: \"Alert when a CRG grade moves backwards along the X → F → E → D → C → B → A scale\"\nseverity: high\ncategory: StandardsCompliance\nauto_fixable: false\nsource: standards/hypatia-rules")
  (query :engine vcl :body "octads(entity=\"crg-grade\")\n  |> order_by(\"temporal.graded_at desc\")\n  |> window_per(\"component\", size=2)\n  |> where(\"grade_rank(previous.grade) > grade_rank(current.grade)\")\n  |> project(\"component, previous.grade, current.grade, graded_at\")")
  (action :body "emit_signal: compliance.finding.new\nmessage_template: \"CRG grade demoted: {component} moved from {previous.grade} to {current.grade} at {graded_at}\"\nrecipe: none")
  (grade_ranks :body "X: 0\nF: 1\nE: 2\nD: 3\nC: 4\nB: 5\nA: 6")
)
