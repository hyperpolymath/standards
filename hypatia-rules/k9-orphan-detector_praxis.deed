;; Hypatia rule k9-orphan-detector. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "k9-orphan-detector"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/k9-orphan-detector.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S002\nname: \"K9 orphan detector\"\ndescription: \"Detect K9 components declared but not wired into any Justfile\"\nseverity: medium\ncategory: Dogfooding\nauto_fixable: false\nsource: standards/hypatia-rules")
  (scanner :type file-tree :body "find:\n  - glob: \"**/coordination.k9\"\n  - glob: \"**/contractile.just\"\n  - glob: \"**/Justfile\"\n  - glob: \"**/justfile\"")
  (logic :engine built-in :body "# For each coordination.k9, extract the repo's declared invariants/protected paths.\n# For each Justfile in the repo, check whether it references those identifiers.\n# A K9 component is an orphan if it is declared but no recipe references it.\nsteps:\n  - parse_k9: \"coordination.k9\"\n  - collect_just_recipes: \"**/[Jj]ustfile\"\n  - cross_reference: \"k9.invariants.*.id\"\n  - emit_unmatched")
  (action :body "emit_signal: compliance.finding.new\nmessage_template: \"K9 orphan: {id} declared in {file} is not referenced by any Justfile recipe\"\nrecipe: none")
)
