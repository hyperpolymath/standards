;; Hypatia rule clade-identity-coherence. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "clade-identity-coherence"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/clade-identity-coherence.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S010\nname: \"CLADE identity coherence\"\ndescription: \"The [identity]/[forges] block of .machine_readable/descriptiles/CLADE.a2ml must declare THIS repository, and its uuid must be the recomputable UUIDv8 profile-C mint for the declared owner/name (domain gv-clade-index)\"\nseverity: high\ncategory: IdentityIntegrity\nauto_fixable: false           # the direction of the fix (declaration vs preimage) is an owner ruling, not a rewrite\nsource: standards/hypatia-rules")
  (scanner :type file-tree :body "target_repo: \"any estate repo carrying .machine_readable/descriptiles/CLADE.a2ml\"\nreference: \"docs/decisions/ADR-008-uuid-v8-estate-standard.adoc\"")
  (parameters :body "profile_c_domains: docs/decisions/ADR-008-profile-c-domains.json\nidentity_domains: [gv-clade-index, julia-package-identity]\ntemplate_canonical_name: rsr-template-repo\ntemplate_repo: hyperpolymath/rsr-template-repo")
  (must :body "# the declaration is THIS repo, not the template it was instantiated from\n- \"primary-owner + canonical-name identify the repository the file lives in (canonical-name == rsr-template-repo outside hyperpolymath/rsr-template-repo is template residue)\"\n- \"forges.github names the repository's actual home; empty rather than the template's forge\"\n- \"born does not predate the repository's first commit\"\n# the uuid is recomputable from the declaration\n- \"uuid == profile-C(domain=gv-clade-index, name=github.com/<primary-owner>/<canonical-name>)\"\n- \"the recorded preimage comment, the derivation note, and the uuid agree\"\n# both metadata documents agree\n- \"CLAUDE.md's identity line carries the same uuid, preimage, forge, and born as CLADE.a2ml\"")
)
