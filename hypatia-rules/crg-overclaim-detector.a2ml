# SPDX-License-Identifier: MPL-2.0
# HYP-S005 — CRG Overclaim Detector
# Flags repos self-declaring a CRG grade that lacks the evidence artefacts
# required by CRG v2.0 (STRICT). Sibling rule to HYP-S001 (demotion detector):
# HYP-S001 catches backwards moves; HYP-S005 catches forwards-overshoots.
#
# Evidence thresholds are derived from the boj-server 2026-04-18 audit,
# which became the first worked example of a v2.0 grade read. See:
#   boj-server/docs/governance/CRG-AUDIT-2026-04-18.adoc
#   rsr-template-repo/docs/governance/CRG-AUDIT-TEMPLATE.adoc

@rule(version="1.0"):
id: HYP-S005
name: "CRG overclaim detector"
description: "Alert when a self-declared CRG grade in STATE.a2ml is not backed by the v2.0 evidence artefacts required for that grade"
severity: high
category: StandardsCompliance
auto_fixable: false
source: standards/hypatia-rules

@scanner(type="file-tree"):
# Ingest the declared grade from every repo with machine-readable state.
find:
  - glob: "**/.machine_readable/STATE.a2ml"
  - glob: "**/.machine_readable/6a2/STATE.a2ml"
  - glob: "**/.machine_readable/**/STATE.scm"
@end

@logic(engine="built-in"):
# Parse the declared grade, then check evidence thresholds per grade.
# A repo is *overclaimed* if its declared grade exceeds what the evidence
# supports under v2.0.
steps:
  - parse_state: "STATE.a2ml"
    extract:
      - key: "crg-grade"
        as: declared
      - key: "crg-grade-achieved"
        as: declared_date
  - classify_repo: "by declared grade"
  - run_evidence_checks: "per grade threshold below"
  - emit_if_gap
@end

@evidence_thresholds:
# What each grade REQUIRES, as file-tree signals the scanner can verify.
# If the declared grade is >= the row and any `requires` item is missing,
# the repo is overclaimed and a finding is emitted.

D:
  requires:
    # RSR D-floor (mandatory for D and above)
    - file: ".machine_readable/6a2/STATE.a2ml"
      or_file: ".machine_readable/STATE.a2ml"
      reason: "RSR R-040 (A2ML metadata)"
    - file: "README.adoc"
      or_file: "README.md"
      reason: "RSR R-001 (orientation)"
    - file: "LICENSE"
      reason: "RSR R-004"
    - file: "Justfile"
      or_file: "justfile"
      reason: "RSR R-020 (no Makefiles)"
    - path: "tests/"
      or_path: "test/"
      or_path: "spec/"
      reason: "v2.0 D needs a test matrix"
    - path: ".github/workflows/"
      reason: "CI evidence of D"
  evidence_of:
    - "test matrix documented in STATE.a2ml ([test-matrix] or total-tests)"
    - "scope documented in STATE.a2ml, ROADMAP.adoc or TOPOLOGY.md"

C:
  requires_all_of: "D"
  requires:
    # v2.0 C adds: dogfooding, CI green, deep per-file + per-directory annotation
    - path: "docs/architecture/"
      reason: "C requires per-directory orientation — architecture subtree"
    - file: "docs/READINESS.md"
      or_file: "docs/READINESS.adoc"
      reason: "C needs a per-component readiness assessment"
    - file: "docs/EXPLAINME.adoc"
      reason: "RSR C annotation floor"
    - state_key: "dogfooding-status"
      in_file: ".machine_readable/6a2/STATE.a2ml"
      reason: "C requires documented dogfooding evidence"
  evidence_of:
    - "CI green in last 7 days (workflow run log)"
    - "per-<<unit>> README coverage >= 90% (cartridges, panels, plugins, modules)"
    - "per-directory orientation README in every non-trivial source subtree"
    - "non-axiomatic believe_me / Admitted / sorry / assert_total = 0"

B:
  requires_all_of: "C"
  requires:
    - state_key: "external-targets"
      in_file: ".machine_readable/6a2/STATE.a2ml"
      reason: "B requires 6+ diverse external targets tested (canonical key)"
      fallback_key: "grade-b-status"
      fallback_caveat: "legacy key; entries are often internal capabilities and must be re-classified"
    - state_key: "issues-fed-back"
      in_file: ".machine_readable/6a2/STATE.a2ml"
      reason: "B requires an issues-fed-back pipeline (canonical key)"
  evidence_of:
    - "6+ diverse external-target entries, each with identity + date + outcome"
    - "external-issue label in the repo's issue tracker with >=1 closed issue"
    - "feedback log or changelog entry attributing a change to an external target"
  negative_signal:
    - "internal-capability items (QUIC, multinode, etc.) do NOT count as external targets"
    - "legacy [grade-b-status] entries that describe internal infrastructure must be moved"

A:
  requires_all_of: "B"
  requires:
    - state_key: "field-signal"
      in_file: ".machine_readable/6a2/STATE.a2ml"
      reason: "A requires real-world external feedback confirming value (canonical key)"
  evidence_of:
    - "multi-source external usage confirmation (testimonials, third-party writeups, papers citing)"
    - "no harm signal: no unresolved safety / correctness incidents in last 90 days"
@end

@schema_conventions:
# Canonical STATE.a2ml section names this rule expects. Repos that pre-date
# these conventions should migrate. `[grade-b-status]` is retained as a
# fallback read for B but its entries must be re-classified — the boj-server
# 2026-04-18 audit demonstrated that internal-capability items under
# [grade-b-status] do not satisfy v2.0 B ("6+ diverse external targets").
sections:
  - name: "[dogfooding-status]"
    grade: C
    shape: "key-value of capability -> \"done | in-progress | planned — <evidence>\""
    established: true
  - name: "[external-targets]"
    grade: B
    shape: "key-value of target-identity -> \"<date> — <test outcome> — <contact or URL>\""
    established: false
    notes: "at least 6 diverse entries; targets must be outside the hyperpolymath estate"
  - name: "[issues-fed-back]"
    grade: B
    shape: "key-value of issue-id -> \"<date> — <external reporter> — <resolution>\""
    established: false
    notes: "links to closed issues on the repo's tracker carrying an external-reporter label"
  - name: "[field-signal]"
    grade: A
    shape: "key-value of signal-source -> \"<date> — <confirmation type> — <reference>\""
    established: false
    notes: "multi-source; e.g. testimonial, third-party writeup, paper citation"
  - name: "[grade-b-status]"
    grade: B (legacy)
    shape: "freeform — mixes internal + external in practice"
    established: true
    notes: "superseded by [external-targets]; entries need re-classification per audit"
@end

@self_consistency_heuristic:
# Added 2026-04-18 after the Phase 3 random sample (civic-connect, bofig,
# januskey) produced 3/3 demote with a shared shape: STATE.a2ml self-declares
# a grade that its own adjacent fields contradict. This heuristic catches the
# worst offenders at zero file-tree cost — it reads only STATE.a2ml.
#
# Contradiction rule: a repo cannot self-consistently claim C (or higher) if
# its own metadata says it is <50% complete and pre-0.5.0. Either the grade
# is wrong, the version is wrong, or the completion score is wrong.
#
# Canonical field: `overall-completion` in STATE.a2ml. A legacy
# `completion-percentage` field may still appear in older snapshots, but it is
# not the primary schema key and must not be required for modern repos.
# The audit convention is: trust version + completion, demote the grade.
#
# This fires BEFORE the file-tree evidence checks; if it fires, a full audit
# may not be needed — the repo is self-inconsistent on the face of it.

grade_ge_c_but_early_stage:
  condition: >-
    parse_state.crg-grade IN {"C", "B", "A"}
    AND parse_state.version < "0.5.0"
    AND (
      parse_state.overall-completion < 50
      OR parse_state.overall-completion IS empty_or_absent
    )
    AND parse_state.dogfooding-status IS empty_or_absent
  severity: high
  finding_kind: self-inconsistent-claim
  exempt_if:
    - "[dogfooding-status] is populated (explains why C is plausible despite the numbers)"
    - "crg-grade-demoted is set to a recent date (repo is already in a correction cycle)"
  message: >-
    {component} claims {declared} with early-stage metadata
    (version={version}, completion={completion}) and no [dogfooding-status].
    Under v2.0 this is an overclaim on the face of STATE.a2ml — demote to E
    (or D if structural-policy compliant), or populate [dogfooding-status]
    with evidence.

grade_ge_c_but_missing_self_consistency_inputs:
  condition: >-
    parse_state.crg-grade IN {"C", "B", "A"}
    AND (
      parse_state.version IS empty_or_absent
      OR parse_state.overall-completion IS empty_or_absent
    )
  severity: high
  finding_kind: self-inconsistent-claim
  message: >-
    {component} claims {declared} but STATE.a2ml is missing version and/or
    overall-completion. The CRG self-consistency precheck cannot run
    without these keys — treat this as a structural overclaim until state
    metadata is completed.

grade_b_but_no_external_targets:
  condition: >-
    parse_state.crg-grade IN {"B", "A"}
    AND parse_state.external-targets IS empty_or_absent
    AND parse_state.grade-b-status IS empty_or_absent
  severity: high
  finding_kind: self-inconsistent-claim
  message: >-
    {component} claims {declared} without any [external-targets] or legacy
    [grade-b-status] entries. B requires 6+ diverse external targets — this is
    a structural overclaim. Demote to C until targets are documented.

grade_a_but_no_field_signal:
  condition: >-
    parse_state.crg-grade == "A"
    AND parse_state.field-signal IS empty_or_absent
  severity: high
  finding_kind: self-inconsistent-claim
  message: >-
    {component} claims A without any [field-signal] entries. A requires
    real-world external feedback — demote to B.

# Cheap pre-filter order: run heuristics first, THEN the file-tree evidence
# scan only on repos that pass self-consistency. This reduces scan cost by
# whatever fraction of the estate is overclaimed on its own state alone.
@end

@action:
emit_signal: compliance.finding.new
message_template: >-
  CRG overclaim: {component} self-declares {declared} but fails {missing_requirement}
  (reason: {reason}). Per CRG v2.0 "honest D > dishonest B" — demote or provide
  evidence. See rsr-template-repo/docs/governance/CRG-AUDIT-TEMPLATE.adoc.
recipe: none
halt_on_violation: false
dedupe_window_days: 7
@end

@sibling_rules:
- HYP-S001 crg-demotion-detector — fires on backwards moves
- HYP-S003 proof-freshness       — fires on stale proof artefacts (C evidence)
- HYP-S004 rsr-self-compliance   — RSR D-floor verifier
@end

@end
