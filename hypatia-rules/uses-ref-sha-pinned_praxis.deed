;; Hypatia rule uses-ref-sha-pinned. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "uses-ref-sha-pinned"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/uses-ref-sha-pinned.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S011\nname: \"Workflow uses refs are SHA-pinned\"\ndescription: \"Every `uses:` ref in .github/workflows must resolve to a full commit SHA (40 hex chars); version tags and moving refs are rejected at content level\"\nseverity: medium\ncategory: CiResilience\nauto_fixable: true            # rewriting @vX.Y.Z to the locked SHA is mechanical when the lock carries the entry\nsource: standards/hypatia-rules")
  (scanner :type repo-tree :body "dir: \".github/workflows\"\nglob: \"*.{yml,yaml}\"")
  (parameters :body "exempt_refs: [docker://]      # container refs use digests, not SHAs")
  (must :body "- \"every `uses:` ref is a full commit SHA (^[0-9a-f]{40}$), with the tag kept only as a trailing comment\"\n- \"a ref matching ^v?\\d+(\\.\\d+)*$ (a version tag) or ^[a-z]+$ that is not a SHA (a moving ref: stable, latest, main) is a finding\"\n- \"the SHA agrees with the repo's actions.lock entry for the same action (defers to PI004 for the comparison itself)\"\n- \"local reusable workflows (`./…`) are exempt — they resolve within the repo\"")
)
