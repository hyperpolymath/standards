;; Hypatia rule crg-overclaim-detector. The .a2ml body is archived; this deed is the live file.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "crg-overclaim-detector"
  :beholding-chora #u5"estate/chora"
  ;; Translated from archived hypatia-rules/crg-overclaim-detector.a2ml. Not an A2ML rule.
  (rule :version "1.0" :body "id: HYP-S005\nname: \"CRG overclaim detector\"\ndescription: \"Alert when a self-declared CRG grade in STATE.a2ml is not backed by the v2.0 evidence artefacts required for that grade\"\nseverity: high\ncategory: StandardsCompliance\nauto_fixable: false\nsource: standards/hypatia-rules")
  (scanner :type file-tree :body "# Ingest the declared grade from every repo with machine-readable state.\nfind:\n  - glob: \"**/.machine_readable/STATE.a2ml\"\n  - glob: \"**/.machine_readable/descriptiles/STATE.a2ml\"\n  - glob: \"**/.machine_readable/**/STATE.scm\"")
  (logic :engine built-in :body "# Parse the declared grade, then check evidence thresholds per grade.\n# A repo is *overclaimed* if its declared grade exceeds what the evidence\n# supports under v2.0.\nsteps:\n  - parse_state: \"STATE.a2ml\"\n    extract:\n      - key: \"crg-grade\"\n        as: declared\n      - key: \"crg-grade-achieved\"\n        as: declared_date\n  - classify_repo: \"by declared grade\"\n  - run_evidence_checks: \"per grade threshold below\"\n  - emit_if_gap")
  (evidence_thresholds :body "# What each grade REQUIRES, as file-tree signals the scanner can verify.\n# If the declared grade is >= the row and any `requires` item is missing,\n# the repo is overclaimed and a finding is emitted.\n\nD:\n  requires:\n    # RSR D-floor (mandatory for D and above)\n    - file: \".machine_readable/descriptiles/STATE.a2ml\"\n      or_file: \".machine_readable/STATE.a2ml\"\n      reason: \"RSR R-040 (A2ML metadata)\"\n    - file: \"README.adoc\"\n      or_file: \"README.md\"\n      reason: \"RSR R-001 (orientation)\"\n    - file: \"LICENSE\"\n      reason: \"RSR R-004\"\n    - file: \"Justfile\"\n      or_file: \"justfile\"\n      reason: \"RSR R-020 (no Makefiles)\"\n    - path: \"tests/\"\n      or_path: \"test/\"\n      or_path: \"spec/\"\n      reason: \"v2.0 D needs a test matrix\"\n    - path: \".github/workflows/\"\n      reason: \"CI evidence of D\"\n  evidence_of:\n    - \"test matrix documented in STATE.a2ml ([test-matrix] or total-tests)\"\n    - \"scope documented in STATE.a2ml, ROADMAP.adoc or TOPOLOGY.adoc\"\n\nC:\n  requires_all_of: \"D\"\n  requires:\n    # v2.0 C adds: dogfooding, CI green, deep per-file + per-directory annotation\n    - path: \"docs/architecture/\"\n      reason: \"C requires per-directory orientation — architecture subtree\"\n    - file: \"docs/READINESS.md\"\n      or_file: \"docs/READINESS.adoc\"\n      reason: \"C needs a per-component readiness assessment\"\n    - file: \"docs/EXPLAINME.adoc\"\n      reason: \"RSR C annotation floor\"\n    - state_key: \"dogfooding-status\"\n      in_file: \".machine_readable/descriptiles/STATE.a2ml\"\n      reason: \"C requires documented dogfooding evidence\"\n  evidence_of:\n    - \"CI green in last 7 days (workflow run log)\"\n    - \"per-<<unit>> README coverage >= 90% (cartridges, panels, plugins, modules)\"\n    - \"per-directory orientation README in every non-trivial source subtree\"\n    - \"non-axiomatic believe_me / Admitted / sorry / assert_total = 0\"\n\nB:\n  requires_all_of: \"C\"\n  requires:\n    - state_key: \"external-targets\"\n      in_file: \".machine_readable/descriptiles/STATE.a2ml\"\n      reason: \"B requires 6+ diverse external targets tested (canonical key)\"\n      fallback_key: \"grade-b-status\"\n      fallback_caveat: \"legacy key; entries are often internal capabilities and must be re-classified\"\n    - state_key: \"issues-fed-back\"\n      in_file: \".machine_readable/descriptiles/STATE.a2ml\"\n      reason: \"B requires an issues-fed-back pipeline (canonical key)\"\n  evidence_of:\n    - \"6+ diverse external-target entries, each with identity + date + outcome\"\n    - \"external-issue label in the repo's issue tracker with >=1 closed issue\"\n    - \"feedback log or changelog entry attributing a change to an external target\"\n  negative_signal:\n    - \"internal-capability items (QUIC, multinode, etc.) do NOT count as external targets\"\n    - \"legacy [grade-b-status] entries that describe internal infrastructure must be moved\"\n\nA:\n  requires_all_of: \"B\"\n  requires:\n    - state_key: \"field-signal\"\n      in_file: \".machine_readable/descriptiles/STATE.a2ml\"\n      reason: \"A requires real-world external feedback confirming value (canonical key)\"\n  evidence_of:\n    - \"multi-source external usage confirmation (testimonials, third-party writeups, papers citing)\"\n    - \"no harm signal: no unresolved safety / correctness incidents in last 90 days\"")
  (schema_conventions :body "# Canonical STATE.a2ml section names this rule expects. Repos that pre-date\n# these conventions should migrate. `[grade-b-status]` is retained as a\n# fallback read for B but its entries must be re-classified — the boj-server\n# 2026-04-18 audit demonstrated that internal-capability items under\n# [grade-b-status] do not satisfy v2.0 B (\"6+ diverse external targets\").\nsections:\n  - name: \"[dogfooding-status]\"\n    grade: C\n    shape: \"key-value of capability -> \\\"done | in-progress | planned — <evidence>\\\"\"\n    established: true\n  - name: \"[external-targets]\"\n    grade: B\n    shape: \"key-value of target-identity -> \\\"<date> — <test outcome> — <contact or URL>\\\"\"\n    established: false\n    notes: \"at least 6 diverse entries; targets must be outside the hyperpolymath estate\"\n  - name: \"[issues-fed-back]\"\n    grade: B\n    shape: \"key-value of issue-id -> \\\"<date> — <external reporter> — <resolution>\\\"\"\n    established: false\n    notes: \"links to closed issues on the repo's tracker carrying an external-reporter label\"\n  - name: \"[field-signal]\"\n    grade: A\n    shape: \"key-value of signal-source -> \\\"<date> — <confirmation type> — <reference>\\\"\"\n    established: false\n    notes: \"multi-source; e.g. testimonial, third-party writeup, paper citation\"\n  - name: \"[grade-b-status]\"\n    grade: B (legacy)\n    shape: \"freeform — mixes internal + external in practice\"\n    established: true\n    notes: \"superseded by [external-targets]; entries need re-classification per audit\"")
  (self_consistency_heuristic :body "# Added 2026-04-18 after the Phase 3 random sample (civic-connect, bofig,\n# januskey) produced 3/3 demote with a shared shape: STATE.a2ml self-declares\n# a grade that its own adjacent fields contradict. This heuristic catches the\n# worst offenders at zero file-tree cost — it reads only STATE.a2ml.\n#\n# Contradiction rule: a repo cannot self-consistently claim C (or higher) if\n# its own metadata says it is <50% complete and pre-0.5.0. Either the grade\n# is wrong, the version is wrong, or the completion score is wrong.\n#\n# Canonical field: `overall-completion` in STATE.a2ml. A legacy\n# `completion-percentage` field may still appear in older snapshots, but it is\n# not the primary schema key and must not be required for modern repos.\n# The audit convention is: trust version + completion, demote the grade.\n#\n# This fires BEFORE the file-tree evidence checks; if it fires, a full audit\n# may not be needed — the repo is self-inconsistent on the face of it.\n\ngrade_ge_c_but_early_stage:\n  condition: >-\n    parse_state.crg-grade IN {\"C\", \"B\", \"A\"}\n    AND parse_state.version < \"0.5.0\"\n    AND (\n      parse_state.overall-completion < 50\n      OR parse_state.overall-completion IS empty_or_absent\n    )\n    AND parse_state.dogfooding-status IS empty_or_absent\n  severity: high\n  finding_kind: self-inconsistent-claim\n  exempt_if:\n    - \"[dogfooding-status] is populated (explains why C is plausible despite the numbers)\"\n    - \"crg-grade-demoted is set to a recent date (repo is already in a correction cycle)\"\n  message: >-\n    {component} claims {declared} with early-stage metadata\n    (version={version}, completion={completion}) and no [dogfooding-status].\n    Under v2.0 this is an overclaim on the face of STATE.a2ml — demote to E\n    (or D if structural-policy compliant), or populate [dogfooding-status]\n    with evidence.\n\ngrade_ge_c_but_missing_self_consistency_inputs:\n  condition: >-\n    parse_state.crg-grade IN {\"C\", \"B\", \"A\"}\n    AND (\n      parse_state.version IS empty_or_absent\n      OR parse_state.overall-completion IS empty_or_absent\n    )\n  severity: high\n  finding_kind: self-inconsistent-claim\n  message: >-\n    {component} claims {declared} but STATE.a2ml is missing version and/or\n    overall-completion. The CRG self-consistency precheck cannot run\n    without these keys — treat this as a structural overclaim until state\n    metadata is completed.\n\ngrade_b_but_no_external_targets:\n  condition: >-\n    parse_state.crg-grade IN {\"B\", \"A\"}\n    AND parse_state.external-targets IS empty_or_absent\n    AND parse_state.grade-b-status IS empty_or_absent\n  severity: high\n  finding_kind: self-inconsistent-claim\n  message: >-\n    {component} claims {declared} without any [external-targets] or legacy\n    [grade-b-status] entries. B requires 6+ diverse external targets — this is\n    a structural overclaim. Demote to C until targets are documented.\n\ngrade_a_but_no_field_signal:\n  condition: >-\n    parse_state.crg-grade == \"A\"\n    AND parse_state.field-signal IS empty_or_absent\n  severity: high\n  finding_kind: self-inconsistent-claim\n  message: >-\n    {component} claims A without any [field-signal] entries. A requires\n    real-world external feedback — demote to B.\n\n# Cheap pre-filter order: run heuristics first, THEN the file-tree evidence\n# scan only on repos that pass self-consistency. This reduces scan cost by\n# whatever fraction of the estate is overclaimed on its own state alone.")
  (action :body "emit_signal: compliance.finding.new\nmessage_template: >-\n  CRG overclaim: {component} self-declares {declared} but fails {missing_requirement}\n  (reason: {reason}). Per CRG v2.0 \"honest D > dishonest B\" — demote or provide\n  evidence. See rsr-template-repo/docs/governance/CRG-AUDIT-TEMPLATE.adoc.\nrecipe: none\nhalt_on_violation: false\ndedupe_window_days: 7")
  (sibling_rules :body "- HYP-S001 crg-demotion-detector — fires on backwards moves\n- HYP-S003 proof-freshness       — fires on stale proof artefacts (C evidence)\n- HYP-S004 rsr-self-compliance   — RSR D-floor verifier")
)
